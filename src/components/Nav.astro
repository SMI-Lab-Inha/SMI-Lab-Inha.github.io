---
import site from '../data/site.json';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';

function isCurrent(href: string) {
  return path === (href.replace(/\/+$/, '') || '/');
}

function isSectionActive(item: any) {
  return isCurrent(item.href) || item.children?.some((child: any) => isCurrent(child.href));
}
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="/">
      <img class="brand-mark" src="/images/icon-88.png" alt="" width="44" height="44" />
      <span class="brand-text">
        <strong>{site.fullName}</strong>
        <small>{site.university}</small>
      </span>
    </a>

    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="primary-nav"
      aria-label="Toggle navigation"
    >
      <span class="nav-toggle-bar"></span>
    </button>

    <nav id="primary-nav" class="nav" aria-label="Primary">
      <ul class="nav-list">
        {
          site.nav.map((item: any, index: number) => (
            <li
              class:list={[
                item.children && 'has-children',
                isSectionActive(item) && 'is-section-active',
              ]}
            >
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
              {item.children && (
                <>
                  <button
                    class="submenu-toggle"
                    type="button"
                    aria-expanded="false"
                    aria-controls={`submenu-${index}`}
                    aria-label={`Show ${item.label} links`}
                  >
                    <span aria-hidden="true">⌄</span>
                  </button>
                  <ul class="submenu" id={`submenu-${index}`}>
                    {item.children.map((child: any) => (
                    <li>
                      <a
                        href={child.href}
                        aria-current={isCurrent(child.href) ? 'page' : undefined}
                      >
                        {child.label}
                      </a>
                    </li>
                    ))}
                  </ul>
                </>
              )}
            </li>
          ))
        }
        <li class="theme-item">
          <select id="theme-select" class="theme-select" aria-label="Colour theme">
            <option value="system">System theme</option>
            <option value="light">Light theme</option>
            <option value="dark">Dark theme</option>
          </select>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector('.nav-toggle');
  const nav = document.getElementById('primary-nav');
  const header = document.querySelector('.site-header');
  const themeSelect = document.querySelector<HTMLSelectElement>('#theme-select');
  const themeStorageKey = 'smi-theme';

  header?.classList.add('nav-enhanced');

  if (themeSelect) {
    let savedTheme = 'system';
    try {
      const storedTheme = localStorage.getItem(themeStorageKey);
      if (storedTheme === 'light' || storedTheme === 'dark') savedTheme = storedTheme;
    } catch {
      // Keep the system setting when storage is unavailable.
    }
    themeSelect.value = savedTheme;

    themeSelect.addEventListener('change', () => {
      const theme = themeSelect.value;
      if (theme === 'light' || theme === 'dark') {
        document.documentElement.dataset.theme = theme;
        try {
          localStorage.setItem(themeStorageKey, theme);
        } catch {
          // The selected theme still applies for the current page.
        }
      } else {
        delete document.documentElement.dataset.theme;
        try {
          localStorage.removeItem(themeStorageKey);
        } catch {
          // The system theme still applies for the current page.
        }
      }
    });
  }

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    nav?.classList.toggle('is-open', !open);
    toggle.setAttribute('aria-label', open ? 'Open navigation' : 'Close navigation');
  });

  nav?.querySelectorAll<HTMLButtonElement>('.submenu-toggle').forEach((button) => {
    button.addEventListener('click', () => {
      const expanded = button.getAttribute('aria-expanded') === 'true';
      button.setAttribute('aria-expanded', String(!expanded));
      button.closest('.has-children')?.classList.toggle('is-expanded', !expanded);
    });
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    toggle?.setAttribute('aria-expanded', 'false');
    toggle?.setAttribute('aria-label', 'Open navigation');
    nav?.classList.remove('is-open');
    nav?.querySelectorAll('.is-expanded').forEach((item) => item.classList.remove('is-expanded'));
    nav?.querySelectorAll('.submenu-toggle').forEach((button) =>
      button.setAttribute('aria-expanded', 'false'),
    );
    if (toggle instanceof HTMLElement) toggle.focus();
  });
</script>

<style>
  .site-header {
    background: var(--c-navy);
    color: #fff;
    border-bottom: 1px solid var(--c-border);
    position: relative;
    z-index: 50;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 4.6rem;
    flex-wrap: wrap;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    color: #fff;
    text-decoration: none;
    padding-block: 0.8rem;
  }

  /* The logo mark is navy-on-white, so it needs a light disc behind it to sit
     on the navy header bar. */
  .brand-mark {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: #fff;
    padding: 2px;
    flex-shrink: 0;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }

  .brand-text strong {
    font-family: var(--font-body);
    font-size: 1.02rem;
    font-weight: 600;
  }

  .brand-text small {
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.72);
  }

  .nav-list {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.2rem;
    margin: 0;
    padding: 0;
  }

  .nav-list li {
    position: relative;
    margin: 0;
    max-width: none;
  }

  .nav-list a {
    display: block;
    color: rgba(255, 255, 255, 0.86);
    text-decoration: none;
    font-size: 0.92rem;
    padding: 0.55rem 0.75rem;
    border-radius: 4px;
    white-space: nowrap;
  }

  .nav-list a:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.1);
  }

  .nav-list a[aria-current='page'] {
    color: #fff;
    box-shadow: inset 0 -2px 0 var(--c-accent);
  }

  .nav-list > .is-section-active > a {
    color: #fff;
  }

  .theme-item {
    display: flex;
    align-items: center;
    margin-left: 0.35rem;
  }

  .theme-select {
    max-width: 8.2rem;
    padding: 0.43rem 0.5rem;
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 4px;
    background: var(--c-navy);
    color: #fff;
    font: inherit;
    font-size: 0.8rem;
    cursor: pointer;
    color-scheme: dark;
  }

  .theme-select:hover,
  .theme-select:focus-visible {
    border-color: #fff;
  }

  .submenu {
    list-style: none;
    margin: 0;
    padding: 0.4rem;
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 13rem;
    background: var(--c-bg);
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
    box-shadow: 0 10px 28px rgba(7, 26, 46, 0.18);
    display: none;
  }

  .submenu-toggle {
    display: none;
  }

  .has-children:hover > .submenu,
  .has-children:focus-within > .submenu {
    display: block;
  }

  .submenu a {
    color: var(--c-text);
    font-size: 0.9rem;
  }

  .submenu a:hover {
    background: var(--c-accent-soft);
    color: var(--c-accent-hover);
  }

  .submenu a[aria-current='page'] {
    color: var(--c-accent);
    box-shadow: none;
    font-weight: 600;
  }

  /* Mobile ---------------------------------------------------------------- */

  .nav-toggle {
    display: none;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 4px;
    width: 2.7rem;
    height: 2.4rem;
    cursor: pointer;
    position: relative;
  }

  .nav-toggle-bar,
  .nav-toggle-bar::before,
  .nav-toggle-bar::after {
    position: absolute;
    left: 50%;
    width: 1.15rem;
    height: 2px;
    background: #fff;
    transform: translateX(-50%);
    content: '';
  }

  .nav-toggle-bar {
    top: 50%;
    margin-top: -1px;
  }
  .nav-toggle-bar::before {
    top: -6px;
  }
  .nav-toggle-bar::after {
    top: 6px;
  }

  @media (max-width: 860px) {
    .site-header.nav-enhanced .nav-toggle {
      display: block;
    }

    .nav {
      width: 100%;
      padding-bottom: 1rem;
    }

    .site-header.nav-enhanced .nav {
      display: none;
    }

    .site-header.nav-enhanced .nav.is-open {
      display: block;
    }

    .nav-list {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    .nav-list > li > a {
      padding-block: 0.7rem;
      border-top: 1px solid rgba(255, 255, 255, 0.12);
    }

    .theme-item {
      margin-left: 0;
      padding: 0.8rem 0.75rem 0;
      border-top: 1px solid rgba(255, 255, 255, 0.12);
    }

    .theme-select {
      width: 100%;
      max-width: none;
    }

    .nav-list > li.has-children {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .submenu-toggle {
      display: block;
      width: 2.75rem;
      border: 0;
      border-top: 1px solid rgba(255, 255, 255, 0.12);
      background: transparent;
      color: #fff;
      cursor: pointer;
      font-size: 1.1rem;
    }

    .submenu-toggle[aria-expanded='true'] span {
      display: inline-block;
      transform: rotate(180deg);
    }

    .submenu {
      position: static;
      display: none;
      background: transparent;
      border: 0;
      box-shadow: none;
      padding: 0 0 0.4rem 1rem;
      grid-column: 1 / -1;
    }

    .has-children.is-expanded > .submenu {
      display: block;
    }

    .submenu a {
      color: rgba(255, 255, 255, 0.8);
    }

    .submenu a:hover {
      background: rgba(255, 255, 255, 0.1);
      color: #fff;
    }
  }
</style>
