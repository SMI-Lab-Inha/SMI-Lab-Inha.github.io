---
interface Props {
  what: string;
}

const { what } = Astro.props;
---

<div class="pending">
  <p><strong>{what}</strong></p>
  <p class="muted">This page will be updated when a verified record is available.</p>
</div>

<style>
  .pending {
    border: 1px dashed var(--c-border-strong);
    border-radius: var(--radius);
    background: var(--c-bg-subtle);
    padding: 1.8rem;
  }

  .pending p:last-child {
    margin-bottom: 0;
  }
</style>
