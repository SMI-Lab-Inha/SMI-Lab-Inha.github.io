---
import { Image } from 'astro:assets';
import { resolveImage } from '../lib/images';

interface Props {
  src: string;
  alt: string;
  class?: string;
  loading?: 'eager' | 'lazy';
  sizes?: string;
  widths?: number[];
}

const {
  src,
  alt,
  class: className,
  loading = 'lazy',
  sizes = '100vw',
  widths = [320, 480, 640, 960],
} = Astro.props;
---

<Image
  src={resolveImage(src)}
  alt={alt}
  class={className}
  loading={loading}
  decoding="async"
  layout="constrained"
  widths={widths}
  sizes={sizes}
/>
