---
interface Props {
  variant: 'hero' | 'mooring' | 'strength' | 'fracture';
  title: string;
  description: string;
}

const { variant, title, description } = Astro.props;
const titleId = `figure-${variant}-title`;
const descriptionId = `figure-${variant}-description`;
---

<figure class:list={['research-figure', `research-figure--${variant}`]}>
  {
    (variant === 'hero' || variant === 'mooring') && (
      <svg viewBox="0 0 720 430" role="img" aria-labelledby={`${titleId} ${descriptionId}`}>
        <title id={titleId}>{title}</title>
        <desc id={descriptionId}>{description}</desc>
        <g class="grid-lines" aria-hidden="true">
          <path d="M45 76H675M45 146H675M45 216H675M45 286H675M45 356H675" />
          <path d="M120 42V390M240 42V390M360 42V390M480 42V390M600 42V390" />
        </g>
        <g class="system" aria-hidden="true">
          <path class="sea" d="M40 236c80-20 150 18 230 0s150-18 230 0 120 18 180 0" />
          <path class="tower" d="M361 96v134M335 230h54l-8 22h-38z" />
          <circle class="hub" cx="361" cy="94" r="8" />
          <path class="blade" d="M361 94 300 68M361 94l55-45M361 94l17 72" />
          <path class="platform" d="M314 252h94l-16 24h-62z" />
          <path class="mooring" d="M327 268c-50 30-102 84-177 91M394 269c50 32 104 84 177 90" />
          <path class="cable" d="M408 270c66 19 60 88 112 95 46 7 72-19 124-3" />
          <circle class="sensor" cx="327" cy="268" r="6" />
          <circle class="sensor" cx="394" cy="269" r="6" />
          <circle class="sensor" cx="520" cy="365" r="6" />
          <path class="signal" d="M252 205c24-28 52-39 79-31M470 205c-24-28-52-39-79-31" />
          <path class="signal" d="m326 169 8 6-9 4M396 169l-8 6 9 4" />
        </g>
        <g class="labels" aria-hidden="true">
          <text x="51" y="55">PHYSICS-BASED STATE ESTIMATION</text>
          <text x="70" y="346">MOORING TENSION</text>
          <text x="506" y="399">CABLE CURVATURE + FATIGUE</text>
          <text x="419" y="118">PLATFORM MOTION</text>
        </g>
      </svg>
    )
  }

  {
    variant === 'strength' && (
      <svg viewBox="0 0 720 430" role="img" aria-labelledby={`${titleId} ${descriptionId}`}>
        <title id={titleId}>{title}</title>
        <desc id={descriptionId}>{description}</desc>
        <g class="grid-lines" aria-hidden="true">
          <path d="M55 72H665M55 142H665M55 212H665M55 282H665M55 352H665" />
          <path d="M120 42V390M240 42V390M360 42V390M480 42V390M600 42V390" />
        </g>
        <g class="system" aria-hidden="true">
          <path class="hull" d="M74 166h252l-30 70H112z" />
          <path class="structure" d="M108 177h188M129 177v43M166 177v50M203 177v52M240 177v48M277 177v39" />
          <path class="curve" d="M398 330c32-91 72-178 116-188 47-10 80 58 121 151" />
          <path class="curve-secondary" d="M398 330c49-57 92-91 133-88 38 3 64 31 104 66" />
          <path class="axis" d="M390 338h257M390 338V105" />
          <circle class="sensor" cx="514" cy="142" r="7" />
        </g>
        <g class="labels" aria-hidden="true">
          <text x="64" y="55">PROGRESSIVE COLLAPSE</text>
          <text x="106" y="264">STIFFENED HULL SECTION</text>
          <text x="468" y="386">CURVATURE</text>
          <text x="404" y="126">MOMENT</text>
          <text x="531" y="132">ULTIMATE STRENGTH</text>
        </g>
      </svg>
    )
  }

  {
    variant === 'fracture' && (
      <svg viewBox="0 0 720 430" role="img" aria-labelledby={`${titleId} ${descriptionId}`}>
        <title id={titleId}>{title}</title>
        <desc id={descriptionId}>{description}</desc>
        <g class="grid-lines mesh" aria-hidden="true">
          <path d="M70 85H650M70 135H650M70 185H650M70 235H650M70 285H650M70 335H650" />
          <path d="M120 60V360M170 60V360M220 60V360M270 60V360M320 60V360M370 60V360M420 60V360M470 60V360M520 60V360M570 60V360M620 60V360" />
          <path d="m70 85 50 50 50-50 50 50 50-50 50 50 50-50 50 50 50-50 50 50 50-50 50 50M70 185l50 50 50-50 50 50 50-50 50 50 50-50 50 50 50-50 50 50 50-50 50 50M70 285l50 50 50-50 50 50 50-50 50 50 50-50 50 50 50-50 50 50 50-50 50 50" />
        </g>
        <g class="system" aria-hidden="true">
          <path class="crack" d="M280 84c18 31-15 45 7 72s-8 43 15 65-4 42 21 66-8 43 20 70" />
          <path class="impact" d="M585 153h-98l24-23M487 153l24 23" />
          <circle class="zone" cx="302" cy="220" r="75" />
          <circle class="zone zone--inner" cx="302" cy="220" r="39" />
        </g>
        <g class="labels" aria-hidden="true">
          <text x="70" y="48">DUCTILE FRACTURE + IMPACT</text>
          <text x="362" y="252">CALIBRATED FAILURE ZONE</text>
          <text x="510" y="137">IMPACT LOAD</text>
        </g>
      </svg>
    )
  }
  <figcaption>
    <strong>{title}</strong>
    <span>{description}</span>
  </figcaption>
</figure>

<style>
  .research-figure {
    margin: 0;
    color: var(--c-text);
  }

  svg {
    width: 100%;
    height: auto;
    display: block;
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
    background: var(--c-bg-subtle);
  }

  .grid-lines {
    fill: none;
    stroke: var(--c-border);
    stroke-width: 1;
  }

  .mesh {
    opacity: 0.75;
  }

  .system {
    fill: none;
    stroke: var(--c-accent);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 4;
  }

  .sea,
  .signal,
  .curve-secondary {
    stroke: var(--c-sky);
  }

  .platform,
  .hull {
    fill: var(--c-accent-soft);
  }

  .sensor,
  .hub {
    fill: var(--c-sky);
    stroke: var(--c-bg);
    stroke-width: 3;
  }

  .structure,
  .axis {
    stroke-width: 2;
  }

  .curve {
    stroke-width: 5;
  }

  .crack {
    stroke-width: 7;
  }

  .impact {
    stroke: var(--c-sky);
    stroke-width: 5;
  }

  .zone {
    stroke: var(--c-sky);
    stroke-dasharray: 8 8;
    stroke-width: 2;
  }

  .zone--inner {
    stroke-dasharray: 3 6;
  }

  .labels {
    fill: var(--c-text-muted);
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  figcaption {
    display: grid;
    gap: 0.15rem;
    margin-top: 0.65rem;
    font-size: 0.82rem;
    line-height: 1.45;
    color: var(--c-text-muted);
  }

  figcaption strong {
    color: var(--c-text);
  }

  .research-figure--hero svg {
    background: rgba(255, 255, 255, 0.045);
    border-color: rgba(255, 255, 255, 0.2);
  }

  .research-figure--hero .grid-lines {
    stroke: rgba(255, 255, 255, 0.09);
  }

  .research-figure--hero .system {
    stroke: #fff;
  }

  .research-figure--hero .sea,
  .research-figure--hero .signal,
  .research-figure--hero .cable {
    stroke: var(--c-sky);
  }

  .research-figure--hero .platform {
    fill: rgba(83, 170, 226, 0.16);
  }

  .research-figure--hero .labels {
    fill: rgba(255, 255, 255, 0.72);
  }

  .research-figure--hero figcaption {
    color: rgba(255, 255, 255, 0.7);
  }

  .research-figure--hero figcaption strong {
    color: #fff;
  }
</style>
