---
import Pending from './Pending.astro';
import { type Publication } from '../data/content';
import { slugify } from '../lib/content';

interface Props {
  items: Publication[];
  emptyWhat: string;
}

const { items, emptyWhat } = Astro.props;

const years = [...new Set(items.map((p) => p.year))].sort((a, b) => Number(b) - Number(a));

// Both of the director's author forms, so his name is emphasised in every
// entry regardless of which name the paper was published under.
const SELF = ['Seo JH', 'Cerik BC'];

function splitAuthors(authors: string) {
  return authors.split(', ').map((a) => ({ name: a, self: SELF.includes(a.trim()) }));
}

// Number the whole list continuously, newest first, the way a CV does.
let n = items.length;
const numbered = new Map<Publication, number>();
for (const year of years) {
  for (const p of items.filter((x) => x.year === year)) {
    numbered.set(p, n--);
  }
}

// Subject tags, ordered by how many papers carry them, so the busiest
// subjects lead the filter row.
const tagCounts = new Map<string, number>();
for (const publication of items) {
  for (const tag of publication.tags) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}
const tags = [...tagCounts.entries()].sort(
  (a, b) => b[1] - a[1] || a[0].localeCompare(b[0]),
);

function paperId(publication: Publication) {
  return `paper-${publication.doi ? publication.doi.replace(/[^a-zA-Z0-9]+/g, '-') : slugify(publication.title)}`;
}
---

{
  items.length === 0 ? (
    <Pending what={emptyWhat} />
  ) : (
    <>
      <div class="publication-tools" data-publication-tools>
        <label>
          <span>Search publications</span>
          <input type="search" placeholder="Title, author, journal, or year" autocomplete="off" data-publication-search />
        </label>
        <p class="exports">
          <a href="/publications/publications.bib" download>Download BibTeX</a>
          <a href="/publications/publications.ris" download>Download RIS</a>
        </p>
        <p class="result-count" aria-live="polite" data-publication-count>{items.length} papers</p>
      </div>

      {tags.length > 0 && (
        <div class="filters">
          <h2 class="filters-title" id="subject-filters">Filter by subject</h2>
          <div class="tag-row" role="group" aria-labelledby="subject-filters">
            {tags.map(([tag, count]) => (
              <button type="button" class="tag" data-tag-filter={tag} aria-pressed="false">
                {tag}
                <span class="tag-count">{count}</span>
              </button>
            ))}
          </div>
        </div>
      )}

      <nav class="jump" aria-label="Jump to year">
        {years.map((y) => (
          <a href={`#y${y}`}>{y}</a>
        ))}
      </nav>

      {years.map((year) => {
        const inYear = items.filter((p) => p.year === year);
        return (
          <section class="year-block" data-year-section>
            <h2 id={`y${year}`}>
              {year}
              <span class="count">
                {inYear.length} {inYear.length === 1 ? 'paper' : 'papers'}
              </span>
            </h2>
            <ol class="list-plain pubs">
              {inYear.map((p) => (
                <li
                  id={paperId(p)}
                  data-publication
                  data-search={`${p.authors} ${p.title} ${p.venue} ${p.year} ${p.tags.join(' ')}`.toLowerCase()}
                  data-tags={p.tags.join('|')}
                >
                  <span class="num">{numbered.get(p)}.</span>
                  <div>
                    <p class="pub-authors">
                      {splitAuthors(p.authors).map((a, i, arr) => (
                        <>
                          {a.self ? <strong>{a.name}</strong> : a.name}
                          {i < arr.length - 1 ? ', ' : ''}
                        </>
                      ))}
                    </p>
                    <p class="pub-title">
                      {p.doi ? <a href={`https://doi.org/${p.doi}`}>{p.title}</a> : p.title}
                    </p>
                    <p class="pub-venue">
                      <em>{p.venue}</em>
                      {p.volume && <span> {p.volume}</span>}
                      {p.pages && <span>: {p.pages}</span>}
                    </p>
                    {p.tags.length > 0 && (
                      <p class="pub-topics">
                        {p.tags.map((tag) => (
                          <button type="button" class="tag" data-tag-filter={tag} aria-pressed="false">
                            {tag}
                          </button>
                        ))}
                      </p>
                    )}
                    {p.doi && (
                      <p class="pub-doi">
                        <a href={`https://doi.org/${p.doi}`}>
                          <span class="doi-tag">DOI</span>
                          {p.doi}
                        </a>
                      </p>
                    )}
                    {(p.preprint || p.code || p.data) && (
                      <p class="pub-links">
                        {p.preprint && <a href={p.preprint}>Preprint</a>}
                        {p.code && <a href={p.code}>Code</a>}
                        {p.data && <a href={p.data}>Data</a>}
                      </p>
                    )}
                  </div>
                </li>
              ))}
            </ol>
          </section>
        );
      })}
    </>
  )
}

<script>
  const search = document.querySelector<HTMLInputElement>('[data-publication-search]');
  const papers = [...document.querySelectorAll<HTMLElement>('[data-publication]')];
  const years = [...document.querySelectorAll<HTMLElement>('[data-year-section]')];
  const count = document.querySelector<HTMLElement>('[data-publication-count]');

  const tagButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-tag-filter]')];

  let activeTag: string | null = null;

  function apply() {
    const query = search?.value.trim().toLowerCase() ?? '';
    let visible = 0;
    for (const paper of papers) {
      const matchesText = !query || Boolean(paper.dataset.search?.includes(query));
      const matchesTag = !activeTag || (paper.dataset.tags?.split('|') ?? []).includes(activeTag);
      const matches = matchesText && matchesTag;
      paper.hidden = !matches;
      if (matches) visible += 1;
    }
    for (const year of years) {
      year.hidden = !year.querySelector('[data-publication]:not([hidden])');
    }
    for (const button of tagButtons) {
      button.setAttribute('aria-pressed', String(button.dataset.tagFilter === activeTag));
    }
    if (count) {
      const noun = visible === 1 ? 'paper' : 'papers';
      count.textContent = activeTag
        ? `${visible} ${noun} tagged ${activeTag}`
        : `${visible} ${noun}`;
    }
  }

  search?.addEventListener('input', apply);

  for (const button of tagButtons) {
    button.addEventListener('click', () => {
      const tag = button.dataset.tagFilter ?? null;
      activeTag = activeTag === tag ? null : tag;
      apply();
      // A pill inside an entry is usually below the fold; bring the
      // filtered list back into view rather than leaving the reader adrift.
      if (!button.closest('.tag-row')) {
        document.querySelector('.filters')?.scrollIntoView({ block: 'start' });
      }
    });
  }
</script>

<style>
  .publication-tools {
    display: grid;
    grid-template-columns: minmax(15rem, 1fr) auto;
    gap: 0.7rem 1.5rem;
    align-items: end;
    padding: 1rem;
    margin-bottom: 1.5rem;
    background: var(--c-bg-subtle);
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
  }

  .publication-tools label span {
    display: block;
    margin-bottom: 0.3rem;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-text-muted);
  }

  .publication-tools input {
    width: 100%;
    min-height: 2.75rem;
    padding: 0.55rem 0.7rem;
    color: var(--c-text);
    background: var(--c-bg);
    border: 1px solid var(--c-border-strong);
    border-radius: var(--radius);
    font-size: 1rem;
  }

  .exports {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    margin: 0;
    font-size: 0.86rem;
  }

  .result-count {
    grid-column: 1 / -1;
    margin: 0;
    font-size: 0.78rem;
    color: var(--c-text-muted);
  }

  .filters {
    margin-bottom: 1.5rem;
  }

  .filters-title {
    margin: 0 0 0.55rem;
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-text-muted);
  }

  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  /* One pill style, used both in the filter row and under each entry. */
  .tag {
    font-family: var(--font-sans);
    font-size: 0.74rem;
    line-height: 1.5;
    color: var(--c-text-muted);
    background: transparent;
    border: 1px solid var(--c-border);
    border-radius: 999px;
    padding: 0.18em 0.7em;
    cursor: pointer;
  }

  .tag:hover {
    border-color: var(--c-accent);
    color: var(--c-accent);
    background: var(--c-accent-soft);
  }

  .tag[aria-pressed='true'] {
    background: var(--c-accent);
    border-color: var(--c-accent);
    color: var(--c-on-accent);
  }

  .tag-count {
    margin-left: 0.45em;
    color: var(--c-text-faint);
  }

  .tag[aria-pressed='true'] .tag-count,
  .tag:hover .tag-count {
    color: inherit;
  }

  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-bottom: 2.5rem;
    padding-bottom: 1.2rem;
    border-bottom: 1px solid var(--c-border);
  }

  .jump a {
    font-family: var(--font-sans);
    font-size: 0.83rem;
    text-decoration: none;
    padding: 0.2em 0.65em;
    border: 1px solid var(--c-border);
    border-radius: 999px;
    color: var(--c-text-muted);
  }

  .jump a:hover {
    border-color: var(--c-accent);
    color: var(--c-accent);
    background: var(--c-accent-soft);
  }

  .year-block h2 {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    font-size: 1.45rem;
    margin-top: 2.8rem;
    padding-bottom: 0.4rem;
    border-bottom: 2px solid var(--c-accent);
    scroll-margin-top: 1.5rem;
  }

  .year-block:first-of-type h2 {
    margin-top: 0;
  }

  .count {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 400;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-text-muted);
  }

  .pubs li {
    display: grid;
    grid-template-columns: 2.4rem 1fr;
    gap: 0.4rem;
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--c-border);
    max-width: none;
  }

  .num {
    font-family: var(--font-sans);
    font-size: 0.86rem;
    color: var(--c-text-faint);
    padding-top: 0.15rem;
  }

  .pubs p {
    margin: 0;
    max-width: 76ch;
  }

  .pub-authors {
    font-size: 0.94rem;
    color: var(--c-text-muted);
  }

  .pub-authors strong {
    color: var(--c-text);
  }

  .pub-title {
    font-size: 1.05rem;
    font-weight: 600;
    margin-block: 0.2rem;
    line-height: 1.4;
  }

  .pub-title a {
    text-decoration: none;
    color: var(--c-text);
  }

  .pub-title a:hover {
    color: var(--c-accent);
    text-decoration: underline;
  }

  .pub-venue {
    font-size: 0.94rem;
    color: var(--c-text-muted);
  }

  .pub-doi {
    margin-top: 0.35rem;
  }

  .pub-topics,
  .pub-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.7rem;
    margin-top: 0.45rem !important;
  }

  .pub-links a {
    font-size: 0.82rem;
    font-weight: 600;
  }

  .pub-doi a {
    font-family: var(--font-mono);
    font-size: 0.79rem;
    text-decoration: none;
    color: var(--c-text-muted);
    word-break: break-all;
  }

  .pub-doi a:hover {
    color: var(--c-accent);
  }

  .doi-tag {
    display: inline-block;
    font-family: var(--font-sans);
    font-weight: 600;
    letter-spacing: 0.06em;
    background: var(--c-accent-soft);
    color: var(--c-accent-hover);
    border-radius: 3px;
    padding: 0.1em 0.4em;
    margin-right: 0.5em;
  }

  @media (max-width: 560px) {
    .publication-tools {
      grid-template-columns: 1fr;
    }

    .pubs li {
      grid-template-columns: 1fr;
      gap: 0.1rem;
    }

    .num {
      display: none;
    }
  }
</style>
