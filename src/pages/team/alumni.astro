---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import { alumni } from '../../data/content';

const list = alumni;
---

<Base title="Alumni" description="Former members of the SMI Lab and where they went next." noindex>
  <PageHeader eyebrow="Team" title="Alumni" />

  <section class="section">
    <div class="wrap">
      {
        list.length === 0 ? (
          <div class="empty-state">
            <p class="eyebrow">Lab established in 2025</p>
            <h2>The first alumni will be listed here</h2>
            <p class="muted">
              The SMI Lab is a young group and does not yet have alumni. Future graduates will
              be listed with their degree, thesis, and next destination.
            </p>
          </div>
        ) : (
          <ul class="list-plain alumni">
            {list.map((a) => (
              <li>
                <span class="year">{a.year}</span>
                <span>
                  <strong>{a.name}</strong>
                  {a.degree && <span class="muted"> · {a.degree}</span>}
                  {a.thesis && <div class="thesis">{a.thesis}</div>}
                  {a.now && <div class="muted">Now: {a.now}</div>}
                </span>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>
</Base>

<style>
  .empty-state {
    max-width: 42rem;
    border-left: 3px solid var(--c-accent);
    padding: 0.25rem 0 0.25rem 1.2rem;
  }

  .empty-state h2 {
    margin-top: 0;
  }

  .alumni li {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: 1rem;
    padding-block: 1rem;
    border-top: 1px solid var(--c-border);
    max-width: none;
  }

  .year {
    color: var(--c-text-muted);
  }

  .thesis {
    font-style: italic;
    color: var(--c-text-muted);
    margin-top: 0.2rem;
  }

  @media (max-width: 620px) {
    .alumni li {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
  }
</style>
