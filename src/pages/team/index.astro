---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import d from '../../data/director.json';
import { alumni } from '../../data/content';

const sections = [
  { href: '/team/director', title: 'Director', text: `${d.name} — ${d.title}.` },
  {
    href: '/team/current-members',
    title: 'Current members',
    text: 'The founding cohort of undergraduate researchers working across the lab’s research programme.',
  },
  {
    href: '/team/alumni',
    title: 'Alumni',
    text: 'Former members, their theses, and where they went next.',
  },
].filter((section) => section.href !== '/team/alumni' || alumni.length > 0);
---

<Base title="Team" description="Professor Jae Hoon Seo and the founding student research cohort of the SMI Lab at Inha University.">
  <PageHeader eyebrow="People" title="Team" />

  <section class="section">
    <div class="wrap">
      <div class="grid">
        {
          sections.map((s) => (
            <a class="card link-card" href={s.href}>
              <h2>{s.title}</h2>
              <p class="muted">{s.text}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .link-card {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .link-card:hover {
    border-color: var(--c-accent);
    color: inherit;
  }

  .link-card h2 {
    color: var(--c-accent);
    font-size: 1.1rem;
    letter-spacing: -0.011em;
    margin-top: 0;
  }
</style>
