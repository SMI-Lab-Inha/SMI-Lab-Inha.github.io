---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import AssetImage from '../../components/AssetImage.astro';
import d from '../../data/director.json';

const profiles = d.profiles.filter((p) => p.url);
const origin = (Astro.site ?? new URL(Astro.url.origin)).origin;
const personSchema = {
  '@type': 'Person',
  '@id': `${origin}/team/director/#person`,
  name: d.name,
  alternateName: [d.formerName, d.nameKo, d.nameHanja],
  description: d.bio,
  image: `${origin}${d.photo}`,
  jobTitle: d.title,
  email: d.email,
  telephone: d.phone,
  identifier: `https://orcid.org/${d.orcid}`,
  url: `${origin}/team/director/`,
  affiliation: { '@id': `${origin}/#lab` },
  worksFor: { '@id': `${origin}/#lab` },
  sameAs: profiles.map((profile) => profile.url),
};
---

<Base
  title="Director"
  description={`${d.name} directs the SMI Lab at Inha University and researches fracture, fatigue, impact, and marine structural mechanics.`}
  ogType="profile"
  structuredData={personSchema}
>
  <PageHeader eyebrow="Team" title="Director" />

  <section class="section">
    <div class="wrap director">
      <div class="portrait">
        <AssetImage
          src={d.photo}
          alt={d.photoAlt}
          loading="eager"
          sizes="(min-width: 820px) 272px, 240px"
          widths={[240, 360, 480, 600]}
        />

        <div class="contact-card">
          <p class="name">{d.name}</p>
          <p class="native"><span lang="ko">{d.nameKo}</span> · <span lang="ko-Hani">{d.nameHanja}</span></p>
          <p class="role">{d.title}</p>
          <hr />
          <p><a href={`mailto:${d.email}`}>{d.email}</a></p>
          <p class="muted">{d.phone}</p>
          <p class="muted">{d.office}</p>
          {
            profiles.length > 0 && (
              <p class="profiles">
                {profiles.map((p) => (
                  <a href={p.url}>{p.label}</a>
                ))}
              </p>
            )
          }
        </div>
      </div>

      <div class="bio">
        <p class="lead">{d.bio}</p>

        <p class="former">
          Papers up to 2025 are published under the name <strong>{d.formerName}</strong>; from
          2026 they appear under <strong>{d.name}</strong>. Both names refer to the same
          author, and the profile links cover the complete record.
        </p>

        <h2>Education</h2>
        <ul class="timeline list-plain">
          {
            d.education.map((e) => (
              <li>
                <span class="when">{e.year}</span>
                <span>
                  <strong>{e.degree}</strong>
                  {e.note && <span class="badge">{e.note}</span>}
                  <br />
                  <span class="muted">{e.institution}</span>
                </span>
              </li>
            ))
          }
        </ul>

        <h2>Appointments</h2>
        <ul class="timeline list-plain">
          {
            d.appointments.map((a) => (
              <li>
                <span class="when">{a.period}</span>
                <span>
                  <strong>{a.role}</strong>
                  <br />
                  <span class="muted">{a.institution}</span>
                  {a.note && <div class="muted note">{a.note}</div>}
                </span>
              </li>
            ))
          }
        </ul>

        <h2>Professional qualifications</h2>
        <ul>
          {d.qualifications.map((q) => <li>{q}</li>)}
        </ul>

        <h2>Professional service</h2>
        <ul>
          {d.service.map((s) => <li>{s}</li>)}
        </ul>

        <h2>Awards</h2>
        <ul>
          {d.awards.map((a) => <li>{a}</li>)}
        </ul>
      </div>
    </div>
  </section>
</Base>

<style>
  .director {
    display: grid;
    grid-template-columns: minmax(0, 17rem) minmax(0, 1fr);
    gap: clamp(1.8rem, 4vw, 3.2rem);
    align-items: start;
  }

  .portrait {
    position: sticky;
    top: 1.5rem;
  }

  .portrait img {
    width: 100%;
    aspect-ratio: 3 / 4;
    border-radius: var(--radius);
    object-fit: cover;
    border: 1px solid var(--c-border);
  }

  .contact-card {
    margin-top: 1rem;
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
    background: var(--c-bg-subtle);
    padding: 1.1rem;
    font-size: 0.93rem;
  }

  .contact-card p {
    margin-bottom: 0.25rem;
  }

  .contact-card hr {
    margin: 0.8rem 0;
  }

  .name {
    font-family: var(--font-body);
    font-size: 1.2rem;
    font-weight: 600;
  }

  .native {
    font-family: var(--font-body);
    color: var(--c-text-muted);
  }

  .role {
    font-weight: 600;
  }

  .profiles {
    margin-top: 0.7rem;
    margin-bottom: 0;
  }

  .profiles a {
    display: block;
    margin-bottom: 0.2rem;
  }

  .bio h2 {
    font-size: 1.2rem;
  }

  .bio h2:first-of-type {
    margin-top: 2em;
  }

  .former {
    border-left: 3px solid var(--c-accent);
    background: var(--c-bg-subtle);
    padding: 0.9rem 1.1rem;
    border-radius: 0 var(--radius) var(--radius) 0;
    font-size: 0.94rem;
  }

  .timeline li {
    display: grid;
    grid-template-columns: 9.5rem 1fr;
    gap: 1rem;
    padding-block: 0.7rem;
    border-top: 1px solid var(--c-border);
    max-width: none;
  }

  .when {
    color: var(--c-text-muted);
    font-size: 0.92rem;
    font-variant-numeric: tabular-nums;
  }

  .note {
    font-size: 0.9rem;
    margin-top: 0.15rem;
  }

  .badge {
    display: inline-block;
    margin-left: 0.5em;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--c-accent-hover);
    background: var(--c-accent-soft);
    border-radius: 999px;
    padding: 0.15em 0.6em;
    vertical-align: 0.15em;
  }

  @media (max-width: 820px) {
    .director {
      grid-template-columns: 1fr;
    }

    .portrait {
      position: static;
      max-width: 15rem;
    }

    .timeline li {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
  }
</style>
