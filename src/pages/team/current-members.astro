---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Pending from '../../components/Pending.astro';
import AssetImage from '../../components/AssetImage.astro';
import { members } from '../../data/content';

const groups = ['Postdoctoral researchers', 'PhD students', "Master's students", 'Undergraduate researchers'];
const byGroup = groups
  .map((g) => ({ group: g, people: members.filter((m) => m.group === g) }))
  .filter((g) => g.people.length > 0);
---

<Base
  title="Current members"
  description="Student researchers of the SMI Lab at Inha University, working on mooring chain fatigue, dynamic power cable integrity, ultimate strength, fracture mechanics, and propeller–ice interaction."
>
  <PageHeader eyebrow="Team" title="Current members" />

  <section class="section">
    <div class="wrap">
      {
        byGroup.length === 0 ? (
          <Pending
            what="No lab members are listed yet."
          />
        ) : (
          byGroup.map((g) => (
            <div class="group">
              <h2>{g.group}</h2>
              <div class="grid">
                {g.people.map((m) => (
                  <article class="card person">
                    {m.photo && (
                      <AssetImage
                        src={m.photo}
                        alt={`Portrait of ${m.name}`}
                        sizes="(min-width: 1000px) 250px, (min-width: 600px) 40vw, 100vw"
                        widths={[240, 360, 480, 640]}
                      />
                    )}
                    <h3>{m.name}</h3>
                    {m.nameKo && <p class="name-ko" lang="ko">{m.nameKo}</p>}
                    {m.role && <p class="role">{m.role}</p>}
                    {m.year && <p class="muted year">{m.year}</p>}
                    {m.topic && <p class="muted">{m.topic}</p>}
                    {m.email && (
                      <p>
                        <a href={`mailto:${m.email}`}>{m.email}</a>
                      </p>
                    )}
                  </article>
                ))}
              </div>
            </div>
          ))
        )
      }
    </div>
  </section>
</Base>

<style>
  .group + .group {
    margin-top: 3rem;
  }

  .group h2 {
    margin-top: 0;
    font-size: 1.25rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--c-border);
  }

  .person img {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: var(--radius);
    margin-bottom: 1rem;
    background: var(--c-bg-inset);
  }

  .person h3 {
    font-size: 1.08rem;
    margin-bottom: 0.1rem;
  }

  .person p {
    margin-bottom: 0.35rem;
  }

  .person p:last-child {
    margin-bottom: 0;
  }

  .name-ko {
    font-family: var(--font-body);
    color: var(--c-text-muted);
  }

  .role {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--c-accent-hover);
    background: var(--c-accent-soft);
    border-radius: 999px;
    padding: 0.15em 0.7em;
  }

  .year {
    font-size: 0.88rem;
  }
</style>
