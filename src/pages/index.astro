---
import Base from '../layouts/Base.astro';
import AssetImage from '../components/AssetImage.astro';
import site from '../data/site.json';
import d from '../data/director.json';
import { members, news, projects, publications, recruitment, researchAreas, software } from '../data/content';
import { newsSlug, positionsLabel, recruitmentOpen, recruitmentStatusLabel, slugify } from '../lib/content';

const latestNews = news.filter((item) => item.kind !== 'recruitment' && item.date)
  .sort((a, b) => b.date.localeCompare(a.date)).slice(0, 3);
const latestPapers = publications.filter((paper) => paper.type === 'journal').slice(0, 2);
const featuredSoftware = software.filter((pkg) => pkg.featured);
const statusLabel: Record<string, string> = { public: 'Public', beta: 'Private · beta', alpha: 'Private · alpha', 'in-development': 'In development' };
---

<Base title={site.fullName} description={site.shortDescription}>
  <section class="hero">
    <div class="wrap hero-inner">
      <div>
        <p class="hero-eyebrow">{site.university} · Naval Architecture and Ocean Engineering</p>
        <h1>Marine Structural Mechanics and Integrity Lab</h1>
        <p class="hero-ko" lang="ko">선박해양 구조역학 및 구조건전성평가 연구실</p>
        <p class="hero-tagline">Fracture and fatigue assessment for ships and offshore structures, through mechanics, sensing, simulation, and research software.</p>
        <p class="hero-actions">
          <a class="btn hero-primary" href="/research/research-areas/">Explore our research</a>
          <a class="btn btn--ghost" href="/join-us/">Join the lab</a>
        </p>
      </div>
      <img class="hero-logo" src="/images/logo.svg" alt="SMI Lab: a ship, wind turbine, and circuit-brain above waves" width="1024" height="1024" decoding="async" />
    </div>
  </section>

  <section class="proof" aria-label="Lab record at a glance">
    <dl class="wrap proof-grid">
      <div><dt>Current projects</dt><dd><a href="/research/projects/">{projects.filter((p) => p.status === 'current').length}</a></dd></div>
      <div><dt>Research areas</dt><dd><a href="/research/research-areas/">{researchAreas.length}</a></dd></div>
      <div><dt>Public tools</dt><dd><a href="/research/software/">{software.filter((p) => p.status === 'public').length}</a></dd></div>
      <div><dt>Student researchers</dt><dd><a href="/team/current-members/">{members.filter((m) => m.group !== 'Postdoctoral researchers').length}</a></dd></div>
    </dl>
  </section>

  <section class="section updates">
    <div class="wrap updates-grid">
      <div>
        <div class="head"><h2>Latest from the lab</h2><a href="/news/">All news →</a></div>
        <ul class="list-plain news-list">
          {latestNews.map((item) => <li>
            <time datetime={item.date}>{item.display}</time>
            <a href={`/news/${newsSlug(item)}/`}>{item.title}</a>
          </li>)}
        </ul>
      </div>
      <aside class="recruitment">
        <h2>Graduate research opportunities</h2>
        <p class="eyebrow">{recruitmentStatusLabel()}</p>
        {recruitmentOpen ? <p><strong>{positionsLabel()}</strong> for the {recruitment.intake}.</p>
          : <p>There are no open graduate positions at present. Contact us about future opportunities.</p>}
        <p class="muted">Undergraduate research slots are {recruitment.undergraduateSlotsAvailable ? 'available' : 'currently full'}.</p>
        <a href="/join-us/">Funding, requirements, and how to apply →</a>
      </aside>
    </div>
  </section>

  <section class="section section--subtle">
    <div class="wrap">
      <div class="head"><h2>Research in marine structural integrity</h2><a href="/research/research-areas/">All research →</a></div>
      <p class="lead">We investigate how marine structures carry load, develop damage, and fail — from fracture in steel to the fatigue of floating offshore wind moorings and dynamic power cables.</p>
      <p class="method">Measure material behaviour. Calibrate mechanical models. Predict failure. Monitor structures in service.</p>
      <div class="thrusts">
        {researchAreas.map((area, i) => <a class="thrust" href={`/research/research-areas/#${area.slug}`}>
          <span class="thrust-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <div><h3>{area.title}</h3><p>{area.short}</p>{area.emerging && <span class="emerging">Emerging direction</span>}</div>
        </a>)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="head"><h2>Recent publications</h2><a href="/publications/journal-papers/">All papers →</a></div>
      <ul class="list-plain papers">
        {latestPapers.map((paper) => <li>
          <h3>{paper.doi ? <a href={`https://doi.org/${paper.doi}`}>{paper.title}</a> : paper.title}</h3>
          <p class="muted">{paper.authors} · {paper.year}</p>
          <p><em>{paper.venue}</em>{paper.volume && ` ${paper.volume}`}{paper.pages && `: ${paper.pages}`}{paper.inPress && ' · In press'}</p>
        </li>)}
      </ul>
    </div>
  </section>

  <section class="section section--subtle">
    <div class="wrap">
      <div class="head"><h2>Research software</h2><a href="/research/software/">Software &amp; facilities →</a></div>
      <p>Tools for cable mechanics, offshore dynamics, and structural analysis. Public packages include source code and documentation; private packages are under development.</p>
      <ul class="pkgs list-plain">
        {featuredSoftware.map((pkg) => <li>
          <div class="pkg-heading"><h3><a href={`/research/software/#${slugify(pkg.name)}`}>{pkg.name}</a></h3><span class:list={['pkg-status', pkg.status === 'public' && 'is-public']}>{statusLabel[pkg.status]}</span></div>
          <p>{pkg.short}</p>
          <a class="pkg-link" href={pkg.repo || `/research/software/#${slugify(pkg.name)}`}>{pkg.repo ? 'Source code →' : 'About this project →'}</a>
        </li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="head"><h2>People behind the research</h2><a href="/team/">Meet the team →</a></div>
      <div class="director-intro">
        <AssetImage src={d.photo} alt={d.photoAlt} widths={[120, 240]} sizes="96px" />
        <div>
          <h3><a href="/team/director/">{d.name}</a> <span lang="ko">{d.nameKo}</span></h3>
          <p>{d.title}, {site.university}. International papers up to 2025 were published as <strong>{d.formerName}</strong>; Korean-language journals and papers from 2026 use {d.name}.</p>
          <a href="/team/director/">Biography and author profiles →</a>
        </div>
      </div>
      <ul class="people list-plain">
        {members.map((member) => <li>
          {member.photo ? <AssetImage src={member.photo} alt={`Portrait of ${member.name}`} sizes="(min-width: 861px) 160px, 72px" widths={[96, 180, 320]} /> : <span class="p-placeholder" aria-hidden="true" />}
          <div><span class="p-name">{member.name}</span><span class="p-topic">{member.topic}</span></div>
        </li>)}
      </ul>
      <p class="values">{site.values.join(' · ')}</p>
    </div>
  </section>

  <section class="section section--subtle">
    <div class="wrap contact">
      <div><h2>Work with SMI Lab</h2><p>We welcome research collaboration on fracture, fatigue, structural assessment, and offshore energy systems.</p></div>
      <p class="contact-actions"><a class="btn" href={`mailto:${site.email}`}>Contact the lab</a><a href="/join-us/">Research opportunities →</a></p>
    </div>
  </section>
</Base>

<style>
  .hero { background: linear-gradient(150deg, var(--c-navy), var(--c-navy-deep)); color: #fff; padding-block: clamp(2rem, 5vw, 4rem); }
  .hero-inner { display: grid; grid-template-columns: minmax(0, 1fr) 15rem; align-items: center; gap: 3rem; }
  .hero h1 { color: #fff; max-width: 24ch; }
  .hero-eyebrow { font-size: 0.78rem; letter-spacing: 0.08em; color: #d3e4f5; }
  .hero-ko { color: #d3e4f5; font-size: 0.88rem; }
  .hero-tagline { font-size: 1.12rem; max-width: 51ch; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.8rem; margin: 1.5rem 0 0; }
  .hero-primary { background: #fff; color: #051766; }
  .hero-primary:hover { background: #eaf4fc; color: #030d3d; }
  .hero .btn--ghost { color: #fff; border-color: #8e9bbc; }
  .hero .btn--ghost:hover { background: #ffffff18; }
  .hero-logo { width: 100%; background: white; padding: 1rem; border-radius: var(--radius); }
  .proof { background: var(--c-navy-deep); color: white; padding-block: 1.1rem; --c-focus: #fff; }
  .proof-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); margin-block: 0; gap: 1rem; }
  .proof-grid div { border-left: 1px solid #ffffff38; padding-left: 1rem; }
  .proof-grid div:first-child { border: 0; padding-left: 0; }
  .proof dt { font-size: 0.76rem; color: #c4cddd; }
  .proof dd { margin: 0; font-size: 1.6rem; font-weight: 700; }
  .proof a { color: #fff; text-decoration: none; }
  .head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; border-bottom: 1px solid var(--c-border-strong); padding-bottom: 0.65rem; margin-bottom: 1.5rem; }
  .head h2 { margin: 0; }
  .head > a { font-size: 0.86rem; flex-shrink: 0; }
  .updates-grid { display: grid; grid-template-columns: 1.3fr 1fr; gap: 2.5rem; }
  .news-list { margin: 0; }
  .news-list li { padding: 0.8rem 0; border-bottom: 1px solid var(--c-border); }
  .news-list time { display: block; color: var(--c-text-muted); font-size: 0.8rem; }
  .recruitment { border-left: 3px solid var(--c-accent); padding: 1.2rem; background: var(--c-bg-subtle); }
  .recruitment h2 { margin-top: 0; font-size: 1.25rem; }
  .recruitment p { margin-bottom: 0.65rem; }
  .recruitment > a { font-size: 0.9rem; }
  .method { font-size: 0.94rem; margin-bottom: 1.8rem; }
  .thrusts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .thrust { display: flex; gap: 0.7rem; padding: 1rem; border: 1px solid var(--c-border); border-radius: var(--radius); background: var(--c-bg); color: inherit; text-decoration: none; }
  .thrust:hover { border-color: var(--c-accent); color: inherit; }
  .thrust-n { color: var(--c-accent); font-size: 0.8rem; padding-top: 0.15rem; }
  .thrust h3 { font-size: 1rem; line-height: 1.35; margin: 0 0 0.45rem; }
  .thrust p { color: var(--c-text-muted); font-size: 0.88rem; line-height: 1.45; margin: 0; }
  .emerging { display: block; color: var(--c-text-muted); font-size: 0.78rem; margin-top: 0.5rem; }
  .papers { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin: 0; }
  .papers h3 { margin: 0 0 0.6rem; font-size: 1.08rem; line-height: 1.4; }
  .papers p { font-size: 0.9rem; margin-bottom: 0.4rem; }
  .pkgs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; margin-bottom: 0; }
  .pkgs > li { padding: 1.1rem; border: 1px solid var(--c-border); border-radius: var(--radius); background: var(--c-bg); display: flex; flex-direction: column; }
  .pkg-heading { display: flex; gap: 0.4rem 0.7rem; flex-wrap: wrap; align-items: center; }
  .pkg-heading h3 { font-size: 1rem; margin: 0; }
  .pkg-status { font-size: 0.73rem; color: var(--c-text-muted); }
  .is-public { color: var(--c-accent); font-weight: 600; }
  .pkgs p { color: var(--c-text-muted); font-size: 0.88rem; margin: 0.7rem 0; }
  .pkg-link { margin-top: auto; font-size: 0.85rem; }
  .director-intro { display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: 1.4rem; align-items: start; margin-bottom: 2rem; }
  .director-intro img { width: 96px; aspect-ratio: 3 / 4; object-fit: cover; border-radius: var(--radius); }
  .director-intro h3 { margin: 0 0 0.6rem; }
  .director-intro h3 span { font-size: 0.9rem; font-weight: 400; }
  .director-intro p { font-size: 0.94rem; margin-bottom: 0.6rem; }
  .director-intro > div > a { font-size: 0.88rem; }
  .people { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 1.2rem; margin: 0; }
  .people img, .p-placeholder { width: 100%; aspect-ratio: 3 / 4; object-fit: cover; border-radius: var(--radius); border: 1px solid var(--c-border); margin-bottom: 0.6rem; }
  .p-placeholder { display: block; background: var(--c-bg-inset); }
  .p-name { display: block; font-weight: 600; font-size: 0.93rem; }
  .p-topic { display: block; color: var(--c-text-muted); font-size: 0.82rem; line-height: 1.45; margin-top: 0.2rem; }
  .values { color: var(--c-text-muted); font-size: 0.86rem; margin: 1.5rem 0 0; }
  .contact { display: grid; grid-template-columns: 1.4fr 1fr; gap: 2rem; align-items: center; }
  .contact h2 { margin-top: 0; }
  .contact p { margin-bottom: 0; }
  .contact-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; }
  @media (max-width: 860px) {
    .hero-inner { grid-template-columns: minmax(0, 1fr) 8rem; gap: 1.2rem; }
    .thrusts, .pkgs { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .updates-grid, .contact { grid-template-columns: 1fr; gap: 1.5rem; }
    .people { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .people li { display: grid; grid-template-columns: 72px minmax(0, 1fr); gap: 0.8rem; }
    .people img, .p-placeholder { width: 72px; }
  }
  @media (max-width: 560px) {
    .hero-inner { grid-template-columns: 1fr; }
    .hero-logo { display: none; }
    .hero-tagline { font-size: 1.02rem; }
    .proof-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.7rem; }
    .proof-grid div:nth-child(odd) { border: 0; padding-left: 0; }
    .head { flex-wrap: wrap; gap: 0.5rem; }
    .thrusts, .pkgs, .papers, .people { grid-template-columns: 1fr; }
    .thrust { padding: 0.85rem; }
    .director-intro { grid-template-columns: 72px minmax(0, 1fr); gap: 1rem; }
    .director-intro img { width: 72px; }
  }
  @media print {
    .hero h1, .hero p { color: #000; }
    .hero-logo, .hero-actions, .contact-actions { display: none; }
    .thrusts, .pkgs { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .thrust, .pkgs li, .papers li { break-inside: avoid; }
  }
</style>
