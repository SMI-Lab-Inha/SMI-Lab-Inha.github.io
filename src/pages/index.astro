---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
import news from '../data/news.json';

const latest = (news as any[]).slice(0, 4);

const glance = [
  'Mooring and dynamic power cable integrity for floating offshore wind: virtual sensing, tension estimation, fatigue assessment',
  'Digital twins of offshore structures: state estimation combining simulation models with monitoring data',
  'Ultimate strength and progressive collapse of ship and offshore structures',
  'Ductile fracture, collision, and impact mechanics of marine structures',
  'Open-source research software for the floating offshore wind ecosystem',
];
---

<Base title={site.fullName} description={site.shortDescription}>
  <section class="hero">
    <div class="wrap hero-inner">
      <div>
        <p class="hero-eyebrow">
          {site.department} · {site.university}
        </p>
        <h1>Marine Structural Mechanics<br />and Integrity Lab</h1>
        <p class="hero-tagline">
          Structural integrity, fatigue, and digital technologies for ships and offshore
          renewable energy systems.
        </p>
        <p class="hero-actions">
          <a class="btn" href="/research/research-areas">Our research</a>
          <a class="btn btn--ghost" href="/research/software">Software</a>
        </p>
      </div>
      <img
        class="hero-logo"
        src="/images/logo.webp"
        alt="SMI Lab logo: a ship, an offshore wind turbine, and a circuit-brain motif above stylised waves"
        width="560"
        height="560"
      />
    </div>
  </section>

  <section class="section">
    <div class="wrap intro">
      <div>
        <h2 class="intro-title">
          Marine Structural Mechanics and Integrity Lab (SMI Lab)
          <span class="ko">선박해양 구조역학 및 구조건전성평가 연구실</span>
        </h2>

        <p>
          The Marine Structural Mechanics and Integrity Lab (SMI Lab) in the Department of
          Naval Architecture and Ocean Engineering at Inha University studies how ships and
          offshore structures carry load, accumulate damage, and fail, and how that knowledge
          can be turned into assessment methods engineers can trust. The lab is led by
          Professor Jae Hoon Seo, who also publishes as Burak Can Cerik.
        </p>

        <p>
          Our current focus is the structural integrity of floating offshore wind turbine
          (FOWT) systems, in particular mooring lines and subsea dynamic power cables. We
          develop physics-based virtual sensing and digital twin methods that estimate
          tension, curvature, and fatigue damage in components that are difficult or expensive
          to instrument directly, using Kalman filtering, state estimation, and surrogate
          models built on nonlinear structural mechanics.
        </p>

        <p>
          This work rests on a longer research foundation in ductile fracture mechanics, ship
          collision and impact analysis, and the ultimate strength of hull structures,
          developed over fifteen years at the University of Ulsan, Newcastle University in
          Singapore, Inha University, and Cranfield University.
        </p>

        <p>
          The lab treats research software as a primary output alongside journal papers. We
          build our analysis tools in-house to professional engineering standards, with
          version control, automated testing, and documentation, and we release them openly
          through the <a href="https://github.com/SMI-Lab-Inha">SMI-Lab-Inha GitHub
          organisation</a> as the accompanying papers are published.
        </p>
      </div>

      <aside class="glance">
        <h3>Research at a glance</h3>
        <ul>
          {glance.map((g) => <li>{g}</li>)}
        </ul>
      </aside>
    </div>
  </section>

  <section class="section section--subtle">
    <div class="wrap values">
      <div>
        <h2>Mission and vision</h2>
        <p class="statement">
          To advance structural integrity science for sustainable and safe marine
          infrastructure, and to become a leading research group supporting carbon-neutral
          maritime and offshore technologies.
        </p>
        <p>
          Marine structures fail in ways that are expensive to discover in service. Our work
          is aimed at understanding those mechanisms well enough to predict them, and at
          making the predictions trustworthy enough to act on.
        </p>
      </div>
      <ul class="value-list list-plain">
        {site.values.map((value) => <li>{value}</li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="news-head">
        <h2>What's happening</h2>
        <a href="/news">All news →</a>
      </div>
      <ul class="list-plain news-list">
        {
          latest.map((n) => (
            <li>
              {n.date && <span class="news-date">{n.date}</span>}
              <a href={n.link && n.link.startsWith('/') ? n.link : '/news'}>{n.title}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap cta">
      <h2>Work with us</h2>
      <p>
        We welcome enquiries from prospective graduate students, visiting researchers, and
        industry partners working on floating wind and marine structural integrity.
      </p>
      <p>
        <a class="btn" href="/join-us">Join the lab</a>
        <a class="btn btn--ghost" href={`mailto:${site.email}`}>Contact</a>
      </p>
    </div>
  </section>

  <section class="section section--subtle">
    <div class="wrap">
      <h2 class="address-title">Find us</h2>
      <address>
        {site.department}<br />
        {site.university}<br />
        {site.address}
      </address>
      <p>
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .hero {
    background: linear-gradient(160deg, var(--c-navy) 0%, var(--c-navy-deep) 100%);
    color: #fff;
    padding-block: clamp(3.2rem, 9vw, 6.5rem);
  }

  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 20rem);
    gap: clamp(1.5rem, 5vw, 3.5rem);
    align-items: center;
  }

  .hero h1 {
    color: #fff;
    margin-bottom: 0.5em;
  }

  /* The logo artwork is navy-on-white, so it needs a light panel behind it. */
  .hero-logo {
    width: 100%;
    max-width: 18rem;
    justify-self: end;
    background: #fff;
    border-radius: var(--radius);
    padding: 1.2rem;
  }

  .news-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid var(--c-border);
    padding-bottom: 0.5rem;
  }

  .news-head h2 {
    margin: 0;
  }

  .news-head a {
    text-decoration: none;
    font-size: 0.92rem;
    white-space: nowrap;
  }

  .news-list {
    margin-top: 1.2rem;
  }

  .news-list li {
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: 1rem;
    padding-block: 0.7rem;
    border-bottom: 1px solid var(--c-border);
    max-width: none;
  }

  .news-date {
    color: var(--c-text-muted);
    font-size: 0.88rem;
  }

  @media (max-width: 860px) {
    .hero-inner {
      grid-template-columns: 1fr;
    }

    .hero-logo {
      justify-self: start;
      max-width: 12rem;
    }

    .news-list li {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
  }

  .hero-eyebrow {
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 1.1rem;
  }

  .hero-tagline {
    font-family: var(--font-serif);
    font-size: clamp(1.1rem, 0.95rem + 0.7vw, 1.35rem);
    color: rgba(255, 255, 255, 0.9);
    line-height: 1.5;
    max-width: 46ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2rem;
    margin-bottom: 0;
  }

  .hero .btn--ghost {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.45);
  }

  .hero .btn--ghost:hover {
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
  }

  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: start;
  }

  .intro-title {
    margin-top: 0;
    font-size: 1.5rem;
  }

  .ko {
    display: block;
    font-size: 1.05rem;
    font-weight: 400;
    color: var(--c-text-muted);
    margin-top: 0.25em;
  }

  .glance {
    background: var(--c-bg-subtle);
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
    padding: 1.5rem;
    position: sticky;
    top: 1.5rem;
  }

  .glance h3 {
    margin-top: 0;
    font-size: 1.05rem;
  }

  .glance ul {
    padding-left: 1.05rem;
    margin-bottom: 0;
  }

  .glance li {
    margin-bottom: 0.7rem;
    font-size: 0.93rem;
  }

  .glance li:last-child {
    margin-bottom: 0;
  }

  .values {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    align-items: start;
  }

  .values h2 {
    margin-top: 0;
  }

  .statement {
    font-size: 1.14rem;
    font-style: italic;
    color: var(--c-text);
    border-left: 3px solid var(--c-accent);
    padding-left: 1.1rem;
    margin-bottom: 1.4rem;
  }

  .value-list {
    display: grid;
    gap: 0.7rem;
    margin: 0;
  }

  .value-list li {
    background: var(--c-bg);
    border: 1px solid var(--c-border);
    border-left: 3px solid var(--c-accent);
    border-radius: var(--radius);
    padding: 0.85rem 1.1rem;
    font-family: var(--font-serif);
    font-size: 1.05rem;
  }

  .cta {
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
    padding: clamp(1.6rem, 4vw, 2.6rem);
  }

  .cta h2 {
    margin-top: 0;
  }

  .cta .btn {
    margin-right: 0.6rem;
  }

  .address-title {
    margin-top: 0;
  }

  address {
    font-style: normal;
    line-height: 1.8;
    margin-bottom: 0.8rem;
  }

  @media (max-width: 860px) {
    .intro {
      grid-template-columns: 1fr;
    }

    .glance {
      position: static;
    }
  }
</style>
