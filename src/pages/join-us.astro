---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import site from '../data/site.json';
import { recruitment, researchAreas } from '../data/content';
import { positionsLabel, recruitmentStatusLabel } from '../lib/content';

// Listed in research-area order; recruitment.json decides which are open.
const recruitingAreas = researchAreas.filter((area) => recruitment.areas.includes(area.slug));
---

<Base
  title="Join us"
  description="Graduate research opportunities in marine structural mechanics, offshore renewable energy, structural integrity and scientific software at SMI Lab, Inha University."
>
  <PageHeader
    eyebrow="Opportunities"
    title="Join us"
  />

  <section class="section">
    <div class="wrap wrap--narrow">
      <p class="ko" lang="ko">
        함께 연구할 대학원생을 모집하고 있습니다. 관심 있는 인하대 조선해양공학과 학부생은
        메일로 연락한 후 면담 바랍니다:{' '}
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>

      <p>
        Graduate students in the lab work on the strength, fatigue, fracture and dynamic
        response of ships and offshore structures, including floating offshore wind. The work
        combines simulation, measurement and structural assessment, and most projects produce
        software, written with version control, automated tests and documentation.
      </p>

      <h2>Areas we are recruiting in</h2>
      <ul>
        {recruitingAreas.map((area) => <li><strong>{area.title}.</strong> {area.short}</li>)}
      </ul>
      <p>
        Methods include engineering critical assessment, state estimation, surrogate modelling
        and differentiable simulation. Assessment of containment systems for alternative fuels
        is a newer direction.
      </p>

      <h2>International collaboration</h2>
      <p>
        We do not host visiting researchers. We are open to international collaboration on the
        topics listed under our <a href="/research/research-areas">research areas</a>.
      </p>

      <h2>Industry collaboration</h2>
      <p>
        We would welcome collaboration with classification societies, offshore wind
        developers, shipyards and technology developers on mooring and cable integrity,
        structural assessment, fatigue and fracture, and alternative-fuel containment.
      </p>

      <h2>How to get in touch</h2>
      <p>
        Email{' '}<a href={`mailto:${site.email}`}>{site.email}</a> with a short description
        of your interests. For graduate applications, please include:
      </p>
      <ul>
        <li>A CV, including your academic record</li>
        <li>A brief statement of the research problems that interest you and why</li>
        <li>Your intended start date and funding situation, if known</li>
      </ul>

      <h2>Open positions</h2>
      {
        recruitment.active ? (
          <div class="open-positions">
            <p class="eyebrow">{recruitmentStatusLabel()}</p>
            <p><strong>{positionsLabel()}</strong> are available for the {recruitment.intake}.</p>
            <p>We are not considering applicants from overseas at present.</p>
            <p class="muted">
              Undergraduate research slots are {recruitment.undergraduateSlotsAvailable
                ? 'also available.'
                : 'currently full.'}
            </p>
            {!recruitment.openUntil && (
              <p class="muted">
                No closing date has been published. Please contact us for the current
                application timetable.
              </p>
            )}
          </div>
        ) : (
          <p>There are no open graduate positions at present.</p>
        )
      }

      <h2>What we look for</h2>
      <p class="who">
        Students who enjoy mechanics, computational modelling and scientific programming.
      </p>
      <ul>
        <li>
          An undergraduate GPA of 3.50 / 4.50 or above in Naval Architecture and Ocean
          Engineering.
        </li>
        <li>Competence in at least one programming language, for example Python or C++.</li>
        <li>Familiarity with finite element analysis concepts.</li>
        <li>
          Capstone design, research internships, or CAE competitions such as the KSOE
          competition strengthen an application.
        </li>
        <li>
          Experience with version control or scientific programming is an advantage.
        </li>
      </ul>

      <h2>What we expect</h2>
      <ul>
        <li>
          Independent research using computational tools such as Abaqus and OrcaFlex.
        </li>
        <li>
          <strong>MSc students:</strong> completion of the degree within two years, and at
          least one publication in an international journal and one in international
          conference proceedings.
        </li>
        <li>
          <strong>PhD students:</strong> progress according to the programme milestones and the
          expected doctoral study period, and at least three international journal papers,
          which will be the core chapters of the PhD dissertation.
        </li>
      </ul>

      <p class="evidence">
        The lab's public packages, in the{' '}
        <a href="https://github.com/SMI-Lab-Inha">SMI-Lab-Inha GitHub organisation</a>, show the
        standard of work we expect.
      </p>

      <h2>What we provide</h2>
      <ul>
        <li>A full research assistantship, including tuition support and a monthly stipend.</li>
        <li>Access to lab computing resources.</li>
        <li>Conference funding.</li>
      </ul>
    </div>
  </section>
</Base>

<style>
  .ko {
    border-left: 3px solid var(--c-accent);
    background: var(--c-bg-subtle);
    padding: 0.9rem 1.1rem;
    border-radius: 0 var(--radius) var(--radius) 0;
    margin-bottom: 2rem;
  }

  .evidence {
    border-left: 3px solid var(--c-sky);
    background: var(--c-accent-soft);
    padding: 0.85rem 1.1rem;
    border-radius: 0 var(--radius) var(--radius) 0;
    font-size: 0.94rem;
  }

  .open-positions {
    border: 1px solid var(--c-border);
    border-left: 3px solid var(--c-accent);
    border-radius: var(--radius);
    padding: 1rem 1.2rem;
    background: var(--c-bg-subtle);
  }

  .open-positions p:last-child {
    margin-bottom: 0;
  }

  .pending-block {
    margin-top: 2.5rem;
    border: 1px dashed var(--c-border-strong);
    border-radius: var(--radius);
    background: var(--c-bg-subtle);
    padding: 1.5rem;
  }

  .pending-block p:last-child {
    margin-bottom: 0;
  }
</style>
