---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Pending from '../components/Pending.astro';
import news from '../data/news.json';

// Kept in the order the lab publishes them (newest first) rather than sorted,
// because several items carry no precise date.
const items = news as any[];
---

<Base title="News" description="Announcements and updates from the SMI Lab.">
  <PageHeader eyebrow="Lab" title="News" />

  <section class="section">
    <div class="wrap wrap--narrow">
      {
        items.length === 0 ? (
          <Pending
            what="No news items have been posted yet."
            how="Add entries to src/data/news.json, newest first."
          />
        ) : (
          items.map((item) => (
            <article class="item">
              {item.date && <p class="date">{item.date}</p>}
              <h2>{item.title}</h2>
              <p>{item.body}</p>
            </article>
          ))
        )
      }
    </div>
  </section>
</Base>

<style>
  .item {
    padding-block: 1.6rem;
    border-top: 1px solid var(--c-border);
  }

  .item:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .item h2 {
    margin-top: 0;
    margin-bottom: 0.3rem;
    font-size: 1.22rem;
  }

  .item p:last-child {
    margin-bottom: 0;
  }

  .date {
    color: var(--c-accent);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 0.3rem;
  }
</style>
