---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Pending from '../components/Pending.astro';
import AssetImage from '../components/AssetImage.astro';
import { news } from '../data/content';
import { newsBody, newsSlug, recruitmentStatusLabel } from '../lib/content';

const all = news;

// Pinned items sit at the top; the rest run newest first. Items whose date the
// lab has not yet supplied keep their relative order at the foot of the list
// rather than being given an invented one.
const pinned = all.filter((n) => n.pinned);
const dated = all.filter((n) => !n.pinned && n.date).sort((a, b) => b.date.localeCompare(a.date));
const undated = all.filter((n) => !n.pinned && !n.date);
const items = [...pinned, ...dated, ...undated];
---

<Base
  title="News"
  description="Announcements and updates from the SMI Lab at Inha University: appointments, conferences, publications, and the people joining the group."
>
  <PageHeader eyebrow="Lab" title="News" />

  <section class="section">
    <div class="wrap wrap--narrow">
      {
        items.length === 0 ? (
          <Pending
            what="No news items have been posted yet."
          />
        ) : (
          items.map((item) => (
            <article class={`item${item.image ? ' has-image' : ''}`} aria-labelledby={`news-${newsSlug(item)}`}>
              {item.image && (
                <AssetImage
                  src={item.image}
                  alt={item.imageAlt}
                  sizes="(min-width: 720px) 240px, 100vw"
                  widths={[320, 480, 640]}
                />
              )}
              <div>
                {item.pinned ? (
                  <p class="date pin">{recruitmentStatusLabel()}</p>
                ) : (
                  item.display && <time class="date" datetime={item.date}>{item.display}</time>
                )}
                <h2 id={`news-${newsSlug(item)}`}>
                  <a href={`/news/${newsSlug(item)}/`}>{item.title}</a>
                </h2>
                <p>{newsBody(item)}</p>
                {item.link && (
                  <p class="more">
                    <a href={item.link}>{item.linkText || 'More'} →</a>
                  </p>
                )}
              </div>
            </article>
          ))
        )
      }
    </div>
  </section>
</Base>

<style>
  .item {
    padding-block: 1.8rem;
    border-top: 1px solid var(--c-border);
  }

  .item:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .item.has-image {
    display: grid;
    grid-template-columns: minmax(0, 15rem) minmax(0, 1fr);
    gap: 1.5rem;
    align-items: start;
  }

  .item img {
    width: 100%;
    border-radius: var(--radius);
    border: 1px solid var(--c-border);
    background: var(--c-bg-subtle);
  }

  .item h2 {
    margin-top: 0;
    margin-bottom: 0.35rem;
    font-size: 1.2rem;
  }

  .item h2 a {
    color: inherit;
    text-decoration: none;
  }

  .item h2 a:hover {
    color: var(--c-accent);
    text-decoration: underline;
  }

  .item p:last-child {
    margin-bottom: 0;
  }

  .date {
    display: block;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-accent);
    margin-bottom: 0.3rem;
  }

  @media (prefers-color-scheme: dark) {
    .date.pin {
      color: var(--c-navy-deep);
    }
  }

  .date.pin {
    display: inline-block;
    background: var(--c-accent);
    color: #fff;
    border-radius: 3px;
    padding: 0.15em 0.55em;
  }

  .more {
    margin-top: 0.6rem;
    font-size: 0.93rem;
  }

  .more a {
    text-decoration: none;
    font-weight: 500;
  }

  .more a:hover {
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .item.has-image {
      grid-template-columns: 1fr;
      gap: 0.9rem;
    }
  }
</style>
