---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import d from '../../data/director.json';

const sections = [
  {
    href: '/publications/journal-papers',
    title: 'Journal papers',
    text: 'Peer-reviewed articles in international journals.',
  },
  {
    href: '/publications/conference-proceedings',
    title: 'Conference proceedings',
    text: 'Papers presented at international conferences and symposia.',
  },
];
---

<Base title="Publications" description="Journal papers and conference proceedings from the SMI Lab.">
  <PageHeader eyebrow="Output" title="Publications" />

  <section class="section">
    <div class="wrap">
      <div class="grid">
        {
          sections.map((s) => (
            <a class="card link-card" href={s.href}>
              <h3>{s.title}</h3>
              <p class="muted">{s.text}</p>
            </a>
          ))
        }
      </div>

      <p class="note">
        Work published before 2019 appears under the name <strong>{d.formerName}</strong>;
        later work appears as <strong>{d.name}</strong>. Both refer to the same author.
      </p>
    </div>
  </section>
</Base>

<style>
  .link-card {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .link-card:hover {
    border-color: var(--c-accent);
    color: inherit;
  }

  .link-card h3 {
    color: var(--c-accent);
  }

  .note {
    margin-top: 2rem;
    border-left: 3px solid var(--c-accent);
    background: var(--c-bg-subtle);
    padding: 0.9rem 1.1rem;
    border-radius: 0 var(--radius) var(--radius) 0;
    font-size: 0.94rem;
  }
</style>
