---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import PublicationList from '../../components/PublicationList.astro';
import { publications } from '../../data/content';

const items = publications.filter((p) => p.type === 'conference');
---

<Base
  title="Conference proceedings"
  description="Conference papers on ship collision, ductile fracture, underwater explosion and naval structural damage, presented at OMAE, PRADS and MARSTRUCT."
>
  <PageHeader
    eyebrow="Publications"
    title="Conference proceedings"
    lead="Papers presented at international conferences and symposia on marine structures."
  />

  <section class="section">
    <div class="wrap">
      <PublicationList
        items={items}
        emptyWhat="No conference proceedings are listed yet."
      />
    </div>
  </section>
</Base>
