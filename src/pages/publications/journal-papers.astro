---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import PublicationList from '../../components/PublicationList.astro';
import { publications } from '../../data/content';
import { publicationSchema } from '../../lib/content';

const items = publications.filter((p) => p.type === 'journal');
const origin = (Astro.site ?? new URL(Astro.url.origin)).origin;
const articleSchema = publicationSchema(items, origin);
---

<Base
  title="Journal papers"
  description="Peer-reviewed work in fracture, fatigue, collision, impact, ultimate strength, and integrity assessment of ships and offshore structures."
  structuredData={articleSchema}
>
  <PageHeader
    eyebrow="Publications"
    title="Journal papers"
    lead="Peer-reviewed journal articles. International papers up to 2025 appear under the name Burak Can Cerik; Korean-language journals and papers from 2026 use Jae Hoon Seo. Both names refer to the same author."
  />

  <section class="section">
    <div class="wrap">
      <PublicationList
        items={items}
        emptyWhat="No journal papers are listed yet."
      />
    </div>
  </section>
</Base>
