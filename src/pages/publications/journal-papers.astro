---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import PublicationList from '../../components/PublicationList.astro';
import { publications } from '../../data/content';

const items = publications.filter((p) => p.type === 'journal');
const origin = (Astro.site ?? new URL(Astro.url.origin)).origin;
const articleSchema = items.map((paper) => ({
  '@type': 'ScholarlyArticle',
  headline: paper.title,
  name: paper.title,
  datePublished: paper.year,
  isPartOf: { '@type': 'Periodical', name: paper.venue },
  author: paper.authors.split(', ').map((author) =>
    author === 'Seo JH' || author === 'Cerik BC'
      ? { '@id': `${origin}/team/director/#person` }
      : { '@type': 'Person', name: author },
  ),
  sameAs: paper.doi ? `https://doi.org/${paper.doi}` : undefined,
  identifier: paper.doi ? `https://doi.org/${paper.doi}` : undefined,
}));
---

<Base
  title="Journal papers"
  description="Peer-reviewed work in fracture, fatigue, collision, impact, ultimate strength, and integrity assessment of ships and offshore structures."
  structuredData={articleSchema}
>
  <PageHeader
    eyebrow="Publications"
    title="Journal papers"
    lead="Peer-reviewed journal articles. Papers up to 2025 are published under the name Burak Can Cerik; both names refer to the same author."
  />

  <section class="section">
    <div class="wrap">
      <PublicationList
        items={items}
        emptyWhat="No journal papers are listed yet."
      />
    </div>
  </section>
</Base>
