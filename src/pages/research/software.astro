---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import { software } from '../../data/content';

const statusLabel: Record<string, string> = {
  public: 'Public',
  beta: 'Private — beta, release planned with first publication',
  alpha: 'Private — alpha, release planned with first publication',
  'in-development': 'In development',
};
---

<Base
  title="Software & facilities"
  description="Research software from the SMI Lab for floating offshore wind simulation, cable mechanics, modal analysis, and reproducible structural engineering."
>
  <PageHeader
    eyebrow="Research"
    title="Software & facilities"
    lead="We build the analysis tools our research needs and release them openly."
  />

  <section class="section">
    <div class="wrap">
      <h2 id="in-house">In-house open-source software</h2>
      <p>
        Each package is developed with version control, automated testing, and documentation,
        and papers using these tools cite the release version used, so results are
        reproducible.
      </p>
      <p class="policy">
        Packages are opened to the public when the paper introducing them is submitted. This
        protects the priority of the methods while guaranteeing that every published result can
        be reproduced with released code.
      </p>

      <div class="stack">
        {
          software.map((s) => (
            <article class="card pkg">
              <h3>
                {s.name}
                {s.expansion && <span class="expansion"> — {s.expansion}</span>}
              </h3>
              <p class="muted">{s.description}</p>
              {(s.language || s.licence || s.version) && (
                <p class="facts">
                  {[s.language, s.licence, s.version].filter(Boolean).join(' · ')}
                </p>
              )}
              <p class="status">
                <span class={`pill ${s.status === 'public' ? 'pill--live' : ''}`}>
                  {statusLabel[s.status]}
                </span>
              </p>
              {(s.repo || s.docs) && (
                <p class="pkg-links">
                  {s.repo && <a href={s.repo}>Repository</a>}
                  {s.docs && (
                    <a href={s.docs}>
                      {s.docs.includes('marketplace.visualstudio.com')
                        ? 'VS Code Marketplace'
                        : 'Documentation'}
                    </a>
                  )}
                </p>
              )}
            </article>
          ))
        }
      </div>

      <p class="muted">
        Bug reports and contributions are welcome on the public repositories, in the
        <a href="https://github.com/SMI-Lab-Inha"> SMI-Lab-Inha GitHub organisation</a>.
      </p>

      <h2 id="commercial">Commercial and community software</h2>
      <p>
        Our simulations run on a stack of industry-standard tools alongside the in-house
        packages. Abaqus is the platform for nonlinear finite element analysis, including user
        material subroutines (VUMAT/UMAT) for fracture modelling and explicit dynamics for
        impact problems. OrcaFlex and OrcaWave handle mooring, cable, and hydrodynamic
        analysis, and OpenFAST provides coupled aero-hydro-servo-elastic simulation of wind
        turbines, including batch design load case processing. Altair HyperWorks covers
        meshing and post-processing. Development is done primarily in Python (NumPy, SciPy,
        JAX, scikit-learn, PyTorch), with MATLAB used for selected signal processing and
        control work.
      </p>

      <h2 id="computing">Computing</h2>
      <p>
        The lab runs a dedicated computational environment for large-scale nonlinear
        simulation, coupled offshore dynamics, and parametric integrity studies, built around
        sustained engineering workloads rather than short interactive jobs.
      </p>

      <div class="machines">
        <article class="machine">
          <p class="eyebrow">Primary simulation workstation</p>
          <h3>SMIL2</h3>
          <p class="muted">
            Optimised for CPU-intensive workloads, high memory use, and long simulation
            campaigns.
          </p>
          <dl>
            <div>
              <dt>Processor</dt>
              <dd>
                AMD Ryzen Threadripper PRO 7965WX, 24 cores / 48 threads, 4.20 GHz base, up to
                5.30 GHz boost
              </dd>
            </div>
            <div>
              <dt>Memory</dt>
              <dd>128 GB DDR5-5200 ECC RDIMM, eight-channel, fully populated</dd>
            </div>
            <div>
              <dt>Graphics</dt>
              <dd>NVIDIA RTX 2000 Ada Generation, 16 GB GDDR6</dd>
            </div>
            <div>
              <dt>Storage</dt>
              <dd>
                2 TB NVMe PCIe Gen5 for system and active projects; 4 TB NVMe PCIe Gen5 for
                simulation data and datasets
              </dd>
            </div>
            <div>
              <dt>Power and cooling</dt>
              <dd>1400 W 92%-efficiency supply; dual front intake fans for sustained load</dd>
            </div>
          </dl>
        </article>

        <article class="machine">
          <p class="eyebrow">Secondary workstation</p>
          <h3>SMIL</h3>
          <p class="muted">
            Supports Abaqus Explicit ice–structure interaction studies and additional parallel
            simulation capacity.
          </p>
          <dl>
            <div>
              <dt>Processor</dt>
              <dd>
                AMD Ryzen Threadripper PRO 7945WX, 12 cores / 24 threads, 4.70 GHz base, up to
                5.30 GHz boost
              </dd>
            </div>
            <div>
              <dt>Memory</dt>
              <dd>128 GB DDR5-5200 ECC RDIMM, eight-channel</dd>
            </div>
            <div>
              <dt>Graphics</dt>
              <dd>NVIDIA RTX A1000, 8 GB GDDR6</dd>
            </div>
            <div>
              <dt>Storage</dt>
              <dd>2 TB and 1 TB NVMe SSD, with a 2 TB HDD for archive</dd>
            </div>
            <div>
              <dt>Power</dt>
              <dd>1400 W high-efficiency supply</dd>
            </div>
          </dl>
        </article>
      </div>
    </div>
  </section>
</Base>

<style>
  .stack {
    display: grid;
    gap: 1.1rem;
    margin-bottom: 1.6rem;
  }

  .pkg h3 {
    margin-top: 0;
    font-size: 1.1rem;
  }

  .expansion {
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: 0.88rem;
    color: var(--c-text-muted);
  }

  .facts {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--c-text-faint);
    margin-bottom: 0.6rem;
  }

  .status {
    margin-bottom: 0;
  }

  .pill {
    display: inline-block;
    font-size: 0.78rem;
    padding: 0.2em 0.7em;
    border-radius: 999px;
    background: var(--c-bg-inset);
    color: var(--c-text-muted);
    border: 1px solid var(--c-border);
  }

  .pill--live {
    background: var(--c-accent-soft);
    color: var(--c-accent-hover);
    border-color: var(--c-accent);
    font-weight: 600;
  }

  .pkg-links {
    margin-top: 0.7rem;
    margin-bottom: 0;
  }

  .pkg-links a {
    margin-right: 1.1rem;
    font-size: 0.92rem;
  }

  .policy {
    border-left: 3px solid var(--c-sky);
    background: var(--c-accent-soft);
    padding: 0.85rem 1.1rem;
    border-radius: 0 var(--radius) var(--radius) 0;
    font-size: 0.94rem;
    max-width: 72ch;
  }

  .machines {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: 1.4rem;
    margin-top: 1.6rem;
  }

  .machine {
    border: 1px solid var(--c-border);
    border-top: 3px solid var(--c-accent);
    border-radius: var(--radius);
    padding: 1.4rem;
  }

  .machine h3 {
    margin: 0.2rem 0 0.5rem;
    font-family: var(--font-mono);
    font-size: 1.05rem;
  }

  .machine dl {
    margin: 1rem 0 0;
    display: grid;
    gap: 0.7rem;
  }

  .machine dt {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-text-muted);
  }

  .machine dd {
    margin: 0.1rem 0 0;
    font-size: 0.92rem;
    line-height: 1.5;
  }
</style>
