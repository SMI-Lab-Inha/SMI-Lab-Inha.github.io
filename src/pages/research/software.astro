---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import { software } from '../../data/content';

import { slugify } from '../../lib/content';

const origin = (Astro.site ?? new URL(Astro.url.origin)).origin;

// Each package as SoftwareSourceCode, so the tooling is discoverable in its
// own right rather than only as prose on a page.
const softwareSchema = software.map((pkg) => ({
  '@type': 'SoftwareSourceCode',
  name: pkg.name,
  alternateName: pkg.expansion || undefined,
  description: pkg.description,
  programmingLanguage: pkg.language || undefined,
  license: pkg.licence || undefined,
  codeRepository: pkg.repo || undefined,
  url: pkg.docs || pkg.repo || undefined,
  author: { '@id': `${origin}/team/director/#person` },
  maintainer: { '@id': `${origin}/#lab` },
  isAccessibleForFree: pkg.status === 'public' || undefined,
}));

const statusLabel: Record<string, string> = {
  public: 'Public',
  beta: 'Private beta, to be released with its first paper',
  alpha: 'Private alpha, to be released with its first paper',
  'in-development': 'In development',
};
---

<Base
  title="Software & facilities"
  description="Research software for fracture and fatigue assessment, marine structural analysis, offshore dynamics, cable mechanics, and reproducible engineering."
  structuredData={softwareSchema}
>
  <PageHeader
    eyebrow="Research"
    title="Software & facilities"
    lead="Software we have written for our research, the commercial tools we use, and our computers."
  />

  <section class="section">
    <div class="wrap">
      <h2 id="in-house">Our packages</h2>
      <p>
        Each package is kept under version control with automated tests and documentation.
        Papers cite the release they used.
      </p>
      <p class="policy">
        Packages are made public when the paper describing them is submitted.
      </p>

      <div class="stack">
        {
          software.map((s) => (
            <article class="card pkg" id={slugify(s.name)}>
              <h3>
                {s.name}
                {s.expansion && <span class="expansion"> — {s.expansion}</span>}
              </h3>
              <p class="muted">{s.description}</p>
              {(s.language || s.licence) && (
                <p class="facts">
                  {[s.language, s.licence].filter(Boolean).join(' · ')}
                </p>
              )}
              <p class="status">
                <span class={`pill ${s.status === 'public' ? 'pill--live' : ''}`}>
                  {statusLabel[s.status]}
                </span>
              </p>
              {(s.repo || s.docs) && (
                <p class="pkg-links">
                  {s.repo && <a href={s.repo}>Repository</a>}
                  {s.docs && (
                    <a href={s.docs}>
                      {s.docs.includes('marketplace.visualstudio.com')
                        ? 'VS Code Marketplace'
                        : 'Documentation'}
                    </a>
                  )}
                </p>
              )}
            </article>
          ))
        }
      </div>

      <p class="muted">
        Bug reports and contributions are welcome in the public repositories of the{' '}
        <a href="https://github.com/SMI-Lab-Inha">SMI-Lab-Inha GitHub organisation</a>.
      </p>

      <h2 id="commercial">Commercial and community software</h2>
      <p>
        Abaqus for nonlinear finite element analysis, with user material subroutines (VUMAT,
        UMAT) for fracture and explicit dynamics for impact; OrcaFlex and OrcaWave for
        moorings, cables and hydrodynamics; OpenFAST for coupled simulation of wind turbines,
        including design load cases; Altair HyperWorks for meshing and post-processing. We
        program mainly in Python (NumPy, SciPy, JAX, scikit-learn, PyTorch), and use MATLAB for
        some signal processing and control work.
      </p>

      <h2 id="computing">Computing</h2>
      <p>
        The lab has two workstations for nonlinear simulation, coupled offshore dynamics and
        parametric studies.
      </p>

      <div class="machines">
        <article class="machine">
          <p class="eyebrow">Primary simulation workstation</p>
          <h3>SMIL2</h3>
          <p class="muted">
            Used for long CPU-intensive runs and large models.
          </p>
          <dl>
            <div>
              <dt>Processor</dt>
              <dd>
                AMD Ryzen Threadripper PRO 7965WX; 24 cores and 48 threads; 4.20 GHz base clock,
                with boost frequencies up to 5.30 GHz
              </dd>
            </div>
            <div>
              <dt>Memory</dt>
              <dd>128 GB DDR5-5200 ECC RDIMM across eight fully populated memory channels</dd>
            </div>
            <div>
              <dt>Graphics</dt>
              <dd>NVIDIA RTX 2000 Ada Generation with 16 GB GDDR6 memory</dd>
            </div>
            <div>
              <dt>Storage</dt>
              <dd>
                2 TB PCIe 5.0 NVMe SSD for the operating system and active projects; dedicated
                4 TB PCIe 5.0 NVMe SSD for simulation outputs and research datasets
              </dd>
            </div>
          </dl>
        </article>

        <article class="machine">
          <p class="eyebrow">Secondary workstation</p>
          <h3>SMIL</h3>
          <p class="muted">
            Used mainly for Abaqus/Explicit ice–structure interaction analyses.
          </p>
          <dl>
            <div>
              <dt>Processor</dt>
              <dd>
                AMD Ryzen Threadripper PRO 7945WX; 12 cores and 24 threads; 4.70 GHz base clock,
                with boost frequencies up to 5.30 GHz
              </dd>
            </div>
            <div>
              <dt>Memory</dt>
              <dd>128 GB DDR5-5200 ECC RDIMM across eight memory channels</dd>
            </div>
            <div>
              <dt>Graphics</dt>
              <dd>NVIDIA RTX A1000 with 8 GB GDDR6 memory</dd>
            </div>
            <div>
              <dt>Storage</dt>
              <dd>2 TB and 1 TB NVMe SSDs, supplemented by a 2 TB HDD for archival storage</dd>
            </div>
          </dl>
        </article>
      </div>
    </div>
  </section>
</Base>

<style>
  .stack {
    display: grid;
    gap: 1.1rem;
    margin-bottom: 1.6rem;
  }

  .pkg h3 {
    margin-top: 0;
    font-size: 1.1rem;
  }

  .expansion {
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: 0.88rem;
    color: var(--c-text-muted);
  }

  .facts {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--c-text-faint);
    margin-bottom: 0.6rem;
  }

  .status {
    margin-bottom: 0;
  }

  .pill {
    display: inline-block;
    font-size: 0.78rem;
    padding: 0.2em 0.7em;
    border-radius: 999px;
    background: var(--c-bg-inset);
    color: var(--c-text-muted);
    border: 1px solid var(--c-border);
  }

  .pill--live {
    background: var(--c-accent-soft);
    color: var(--c-accent-hover);
    border-color: var(--c-accent);
    font-weight: 600;
  }

  .pkg-links {
    margin-top: 0.7rem;
    margin-bottom: 0;
  }

  .pkg-links a {
    margin-right: 1.1rem;
    font-size: 0.92rem;
  }

  .policy {
    border-left: 3px solid var(--c-sky);
    background: var(--c-accent-soft);
    padding: 0.85rem 1.1rem;
    border-radius: 0 var(--radius) var(--radius) 0;
    font-size: 0.94rem;
    max-width: 72ch;
  }

  .machines {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: 1.4rem;
    margin-top: 1.6rem;
  }

  .machine {
    border: 1px solid var(--c-border);
    border-top: 3px solid var(--c-accent);
    border-radius: var(--radius);
    padding: 1.4rem;
  }

  .machine h3 {
    margin: 0.2rem 0 0.5rem;
    font-family: var(--font-mono);
    font-size: 1.05rem;
  }

  .machine dl {
    margin: 1rem 0 0;
    display: grid;
    gap: 0.7rem;
  }

  .machine dt {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-text-muted);
  }

  .machine dd {
    margin: 0.1rem 0 0;
    font-size: 0.92rem;
    line-height: 1.5;
  }
</style>
