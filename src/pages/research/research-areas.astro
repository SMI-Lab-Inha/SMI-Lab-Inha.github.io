---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import { publications, researchAreas as areas } from '../../data/content';

// Thrusts store DOIs only; the citation itself is resolved from the publication
// record at build time, so the two can never drift apart.
const byDoi = new Map(publications.map((p) => [p.doi, p]));
const cite = (doi: string) => byDoi.get(doi);
---

<Base
  title="Research areas"
  description="Mooring and dynamic power cable integrity for floating offshore wind, ultimate strength and progressive collapse, and ductile fracture and impact mechanics of marine structures."
>
  <PageHeader
    eyebrow="Research"
    title="Research"
    lead="Three research thrusts, and one cross-cutting capability that runs through all of them."
  />

  <section class="section">
    <div class="wrap">
      <div class="how">
        <h2>How we work</h2>
        <p>
          We start from structural mechanics. Every monitoring method, learning model, or
          software tool the lab produces is built on a physics-based description of how the
          structure carries load, so that its predictions remain interpretable and defensible
          in safety-critical use. Where data-driven methods appear in our work, they estimate
          states and parameters of a mechanical model; they do not replace it.
        </p>
      </div>

      {
        areas.map((area, i) => (
          <article class="area" id={area.slug}>
            <p class="area-index">{String(i + 1).padStart(2, '0')}</p>
            <div>
              <h2>{area.title}</h2>
              <p>{area.summary}</p>

              <h3>Current work includes</h3>
              <ul class="topics">
                {area.topics.map((topic) => (
                  <li>{topic}</li>
                ))}
              </ul>

              {'funding' in area && area.funding && (
                <div class="funding">
                  <h3>Funded by</h3>
                  <ul>
                    {area.funding.map((f: string) => (
                      <li>{f}</li>
                    ))}
                  </ul>
                  <p>
                    <a href="/research/projects">All projects</a>
                  </p>
                </div>
              )}

              {'selected' in area && area.selected && area.selected.length > 0 && (
                <div class="selected">
                  <h3>Evidence from the publication record</h3>
                  <ol class="list-plain">
                    {area.selected.map((doi: string) => {
                      const p = cite(doi);
                      return p ? (
                        <li>
                          <span class="cite-authors">{p.authors}</span> ({p.year}).{' '}
                          <a href={`https://doi.org/${p.doi}`}>{p.title}</a>.{' '}
                          <em>{p.venue}</em>
                          {p.volume && <span> {p.volume}</span>}
                          {p.pages && <span>: {p.pages}</span>}.
                        </li>
                      ) : null;
                    })}
                  </ol>
                  <p>
                    <a href="/publications/journal-papers">The full list</a>
                  </p>
                </div>
              )}

              {'lineage' in area && area.lineage && (
                <p class="lineage">
                  <strong>Where this comes from.</strong> {area.lineage}
                </p>
              )}

              {'emerging' in area && area.emerging && (
                <p class="aside">
                  <strong>Emerging direction.</strong> {area.emerging}
                </p>
              )}

              {'methods' in area && area.methods && (
                <p class="methods">
                  <strong>Methods and tools.</strong> {area.methods}{' '}
                  <a href="/research/software">See the software portfolio</a>.
                </p>
              )}
            </div>
          </article>
        ))
      }

      <article class="area cross">
        <p class="area-index">+</p>
        <div>
          <h2>Cross-cutting capability: research software engineering</h2>
          <p>
            Every thrust above produces software, and the lab treats that software as a
            research output in its own right. Packages are developed under version control
            with automated test suites, continuous integration, and documentation, and are
            released publicly as the accompanying papers appear. Graduate students in the lab
            learn this workflow from their first semester, including AI-assisted development
            practice.
          </p>
          <p>
            <a class="btn btn--ghost" href="/research/software">Software &amp; facilities</a>
          </p>
        </div>
      </article>

      <div class="partners">
        <h2>Partnerships and roles</h2>
        <ul>
          <li>
            Professor Seo is a member of the ISSC Specialist Committee V.4 — Offshore
            Renewable Energy for 2025–2028, representing the Republic of Korea.
          </li>
          <li>
            The lab participates as co-investigator in the MOF-funded BEACON marine workforce
            project (2025–2029) and the MOTIE-funded Digital Shipyard professional training
            programme (2026–2031).
          </li>
          <li>
            We welcome collaboration with classification societies, offshore wind developers,
            and research groups working on floating wind structural integrity. Contact:
            <a href="mailto:jaehoon.seo@inha.ac.kr">jaehoon.seo@inha.ac.kr</a>
          </li>
        </ul>
      </div>
    </div>
  </section>
</Base>

<style>
  .how {
    padding-bottom: 2.2rem;
  }

  .how h2 {
    margin-top: 0;
  }

  .area {
    display: grid;
    grid-template-columns: 4rem 1fr;
    gap: 1.5rem;
    padding-block: 2.5rem;
    border-top: 1px solid var(--c-border);
    scroll-margin-top: 2rem;
  }

  .area h2 {
    margin-top: 0;
  }

  .area h3 {
    font-size: 0.82rem;
    font-family: var(--font-sans);
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--c-text-muted);
    margin-top: 1.6em;
  }

  .area-index {
    font-family: var(--font-body);
    font-size: 1.6rem;
    color: var(--c-accent);
    margin: 0;
    line-height: 1.4;
  }

  .topics {
    padding-left: 1.1rem;
  }

  .topics li {
    margin-bottom: 0.5rem;
  }

  .funding ul {
    padding-left: 1.1rem;
    margin-bottom: 0.5rem;
  }

  .funding li {
    font-size: 0.92rem;
    margin-bottom: 0.3rem;
  }

  .funding p,
  .selected p {
    font-size: 0.9rem;
    margin-bottom: 0;
  }

  .selected ol {
    counter-reset: cite;
    margin-bottom: 0.7rem;
  }

  .selected li {
    counter-increment: cite;
    position: relative;
    padding-left: 1.6rem;
    margin-bottom: 0.7rem;
    font-size: 0.93rem;
    line-height: 1.5;
    max-width: 76ch;
  }

  .selected li::before {
    content: counter(cite) '.';
    position: absolute;
    left: 0;
    color: var(--c-text-faint);
    font-variant-numeric: tabular-nums;
  }

  .cite-authors {
    color: var(--c-text-muted);
  }

  .selected a {
    text-decoration: none;
  }

  .selected a:hover {
    text-decoration: underline;
  }

  .lineage {
    font-size: 0.94rem;
    border-left: 3px solid var(--c-sky);
    padding: 0.8rem 1.1rem;
    background: var(--c-accent-soft);
    border-radius: 0 var(--radius) var(--radius) 0;
    max-width: 72ch;
  }

  .aside,
  .methods {
    font-size: 0.94rem;
    color: var(--c-text-muted);
    border-left: 3px solid var(--c-border-strong);
    padding: 0.7rem 1rem;
    background: var(--c-bg-subtle);
    border-radius: 0 var(--radius) var(--radius) 0;
    max-width: 72ch;
  }


  .cross .area-index {
    font-size: 2rem;
    line-height: 1.1;
  }

  .partners {
    border-top: 1px solid var(--c-border);
    padding-top: 2.5rem;
  }

  .partners h2 {
    margin-top: 0;
  }

  .partners li {
    margin-bottom: 0.6rem;
  }

  @media (max-width: 640px) {
    .area {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }
  }
</style>
