---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import areas from '../../data/research-areas.json';

const FIGURES: Record<string, { src: string; alt: string; caption: string }> = {
  'mooring-and-cable-integrity': {
    src: '/images/figures/lazy-wave-cable.svg',
    alt: 'Lazy-wave dynamic power cable running from a floating platform hang-off, down to the sag bend, up over the buoyancy section to the hog bend, and down to touchdown on the seabed.',
    caption:
      'A lazy-wave dynamic power cable. Curvature, and with it fatigue damage, concentrates at the sag and hog bends and in the touchdown zone — the regions our virtual sensing work aims to reconstruct without instrumenting the cable directly.',
  },
  'ultimate-strength': {
    src: '/images/figures/moment-curvature.svg',
    alt: 'Moment–curvature curve for a hull girder, showing the elastic range, first yield, the ultimate moment, and post-collapse softening.',
    caption:
      'Progressive collapse of a hull girder. Beyond first yield the section softens as compressed stiffened panels buckle and shed load, and the peak of the curve defines the ultimate bending moment.',
  },
  'fracture-and-impact': {
    src: '/images/figures/fracture-locus.svg',
    alt: 'Ductile fracture locus: equivalent plastic strain to fracture falling as stress triaxiality increases, marked at pure shear, uniaxial tension, plane strain and equibiaxial states.',
    caption:
      'A ductile fracture locus for shipbuilding steel. The strain a plate can sustain before fracture depends strongly on the stress state, which is why collision and grounding analyses need a triaxiality-dependent criterion rather than a single limiting strain.',
  },
};
---

<Base
  title="Research areas"
  description="Mooring and dynamic power cable integrity for floating offshore wind, ultimate strength and progressive collapse, and ductile fracture and impact mechanics of marine structures."
>
  <PageHeader
    eyebrow="Research"
    title="Research"
    lead="Three research thrusts, and one cross-cutting capability that runs through all of them."
  />

  <section class="section">
    <div class="wrap">
      <div class="how">
        <h2>How we work</h2>
        <p>
          We start from structural mechanics. Every monitoring method, learning model, or
          software tool the lab produces is built on a physics-based description of how the
          structure carries load, so that its predictions remain interpretable and defensible
          in safety-critical use. Where data-driven methods appear in our work, they estimate
          states and parameters of a mechanical model; they do not replace it.
        </p>
      </div>

      {
        areas.map((area, i) => (
          <article class="area" id={area.slug}>
            <p class="area-index">{String(i + 1).padStart(2, '0')}</p>
            <div>
              <h2>{area.title}</h2>
              <p>{area.summary}</p>

              <h3>Current work includes</h3>
              <ul class="topics">
                {area.topics.map((topic) => (
                  <li>{topic}</li>
                ))}
              </ul>

              {FIGURES[area.slug] && (
                <figure class="diagram">
                  <img
                    src={FIGURES[area.slug].src}
                    alt={FIGURES[area.slug].alt}
                    loading="lazy"
                  />
                  <figcaption>{FIGURES[area.slug].caption}</figcaption>
                </figure>
              )}

              {'emerging' in area && area.emerging && (
                <p class="aside">
                  <strong>Emerging direction.</strong> {area.emerging}
                </p>
              )}

              {'methods' in area && area.methods && (
                <p class="methods">
                  <strong>Methods and tools.</strong> {area.methods}{' '}
                  <a href="/research/software">See the software portfolio</a>.
                </p>
              )}
            </div>
          </article>
        ))
      }

      <article class="area cross">
        <p class="area-index">+</p>
        <div>
          <h2>Cross-cutting capability: research software engineering</h2>
          <p>
            Every thrust above produces software, and the lab treats that software as a
            research output in its own right. Packages are developed under version control
            with automated test suites, continuous integration, and documentation, and are
            released publicly as the accompanying papers appear. Graduate students in the lab
            learn this workflow from their first semester, including AI-assisted development
            practice.
          </p>
          <p>
            <a class="btn btn--ghost" href="/research/software">Software &amp; facilities</a>
          </p>
        </div>
      </article>

      <div class="partners">
        <h2>Partnerships and roles</h2>
        <ul>
          <li>
            Professor Seo is a member of the ISSC Specialist Committee V.4 — Offshore
            Renewable Energy for 2025–2028, representing the Republic of Korea.
          </li>
          <li>
            The lab participates as co-investigator in the MOF-funded BEACON marine workforce
            project (2025–2029) and the MOTIE-funded Digital Shipyard professional training
            programme (2026–2031).
          </li>
          <li>
            We welcome collaboration with classification societies, offshore wind developers,
            and research groups working on floating wind structural integrity. Contact:
            <a href="mailto:jaehoon.seo@inha.ac.kr">jaehoon.seo@inha.ac.kr</a>
          </li>
        </ul>
      </div>
    </div>
  </section>
</Base>

<style>
  .how {
    padding-bottom: 2.2rem;
  }

  .how h2 {
    margin-top: 0;
  }

  .area {
    display: grid;
    grid-template-columns: 4rem 1fr;
    gap: 1.5rem;
    padding-block: 2.5rem;
    border-top: 1px solid var(--c-border);
    scroll-margin-top: 2rem;
  }

  .area h2 {
    margin-top: 0;
  }

  .area h3 {
    font-size: 0.82rem;
    font-family: var(--font-sans);
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--c-text-muted);
    margin-top: 1.6em;
  }

  .area-index {
    font-family: var(--font-serif);
    font-size: 1.6rem;
    color: var(--c-accent);
    margin: 0;
    line-height: 1.4;
  }

  .topics {
    padding-left: 1.1rem;
  }

  .topics li {
    margin-bottom: 0.5rem;
  }

  .aside,
  .methods {
    font-size: 0.94rem;
    color: var(--c-text-muted);
    border-left: 3px solid var(--c-border-strong);
    padding: 0.7rem 1rem;
    background: var(--c-bg-subtle);
    border-radius: 0 var(--radius) var(--radius) 0;
    max-width: 72ch;
  }

  .diagram {
    margin: 1.8rem 0 0;
    max-width: 42rem;
  }

  .diagram img {
    width: 100%;
    height: auto;
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
    background: #fff;
  }

  .diagram figcaption {
    font-size: 0.88rem;
    color: var(--c-text-muted);
    line-height: 1.55;
    margin-top: 0.6rem;
    max-width: 62ch;
  }

  .cross .area-index {
    font-size: 2rem;
    line-height: 1.1;
  }

  .partners {
    border-top: 1px solid var(--c-border);
    padding-top: 2.5rem;
  }

  .partners h2 {
    margin-top: 0;
  }

  .partners li {
    margin-bottom: 0.6rem;
  }

  @media (max-width: 640px) {
    .area {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }
  }
</style>
