---
import fs from 'node:fs';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import { publications, researchAreas as areas } from '../../data/content';

// Thrusts store DOIs only; the citation itself is resolved from the publication
// record at build time, so the two can never drift apart.
const byDoi = new Map(publications.map((p) => [p.doi, p]));
const cite = (doi: string) => byDoi.get(doi);

// Intrinsic size comes from the file rather than the data, so a figure cannot
// be redrawn at a new aspect ratio and leave a stale number behind. Width and
// height reserve the space before the SVG loads, which is what stops the text
// below it jumping on slow connections.
const figureSize = (src: string) => {
  const svg = fs.readFileSync(`public${src}`, 'utf8').slice(0, 800);
  const w = svg.match(/\bwidth="([\d.]+)(?:px)?"/);
  const h = svg.match(/\bheight="([\d.]+)(?:px)?"/);
  if (!w || !h) throw new Error(`${src} has no intrinsic width and height`);
  return { width: Math.round(Number(w[1])), height: Math.round(Number(h[1])) };
};
---

<Base
  title="Research areas"
  description="Ductile fracture, ship collision and grounding, underwater explosion, ultimate strength and progressive collapse, floating offshore wind moorings and dynamic power cable fatigue, virtual sensing, and peridynamic crack modelling."
>
  <PageHeader
    eyebrow="Research"
    title="Research"
    lead="Fracture and fatigue are the core of our structural integrity research, supported by nonlinear structural mechanics and research software."
  />

  <section class="section">
    <div class="wrap">
      <div class="how">
        <h2>How we work</h2>
        <p>
          We begin with the mechanics of damage and failure: how loads are carried, how cracks
          form and grow, and how cyclic or extreme loading leads to loss of structural
          performance. Every assessment method, monitoring model, or software tool is grounded
          in physics so that its predictions remain interpretable and defensible in
          safety-critical use. Data-driven methods estimate states and parameters of mechanical
          models; they do not replace those models.
        </p>
        {/* Nine thrusts make a long page. This lets a reader who arrived for
            one of them get there without scrolling past the other eight. */}
        <nav class="jump" aria-label="Research thrusts">
          <ol>
            {
              areas.map((area, i) => (
                <li>
                  <a href={`#${area.slug}`}>
                    <span class="jump-n">{String(i + 1).padStart(2, '0')}</span>
                    {area.title}
                  </a>
                </li>
              ))
            }
          </ol>
        </nav>
      </div>

      {
        areas.map((area, i) => (
          <article class="area" id={area.slug}>
            <p class="area-index">{String(i + 1).padStart(2, '0')}</p>
            <div>
              <h2>{area.title}</h2>
              <p>{area.summary}</p>

              {area.figure && (
                <figure class="area-figure">
                  <img
                    src={area.figure}
                    alt={area.figureAlt}
                    width={figureSize(area.figure).width}
                    height={figureSize(area.figure).height}
                    loading="lazy"
                    decoding="async"
                  />
                  <figcaption>{area.figureCaption}</figcaption>
                </figure>
              )}

              <h3>Current work includes</h3>
              <ul class="topics">
                {area.topics.map((topic) => (
                  <li>{topic}</li>
                ))}
              </ul>

              {'funding' in area && area.funding && (
                <div class="funding">
                  <h3>Funded by</h3>
                  <ul>
                    {area.funding.map((f: string) => (
                      <li>{f}</li>
                    ))}
                  </ul>
                  <p>
                    <a href="/research/projects">All projects</a>
                  </p>
                </div>
              )}

              {'selected' in area && area.selected && area.selected.length > 0 && (
                <div class="selected">
                  <h3>Evidence from the publication record</h3>
                  <ol class="list-plain">
                    {area.selected.map((doi: string) => {
                      const p = cite(doi);
                      return p ? (
                        <li>
                          <span class="cite-authors">{p.authors}</span> ({p.year}).{' '}
                          <a href={`https://doi.org/${p.doi}`}>{p.title}</a>.{' '}
                          <em>{p.venue}</em>
                          {p.volume && <span> {p.volume}</span>}
                          {p.pages && <span>: {p.pages}</span>}.
                        </li>
                      ) : null;
                    })}
                  </ol>
                  <p>
                    <a href="/publications/journal-papers">The full list</a>
                  </p>
                </div>
              )}

              {'lineage' in area && area.lineage && (
                <p class="lineage">
                  <strong>Where this comes from.</strong> {area.lineage}
                </p>
              )}

              {'emerging' in area && area.emerging && (
                <p class="aside">
                  <strong>Emerging direction.</strong> {area.emerging}
                </p>
              )}

              {'methods' in area && area.methods && (
                <p class="methods">
                  <strong>Methods and tools.</strong> {area.methods}{' '}
                  <a href="/research/software">See the software portfolio</a>.
                </p>
              )}
            </div>
          </article>
        ))
      }

      <article class="area cross">
        <p class="area-index">+</p>
        <div>
          <h2>Cross-cutting capability: research software engineering</h2>
          <p>
            Every thrust above produces software, and the lab treats that software as a
            research output in its own right. Packages are developed under version control
            with automated test suites, continuous integration, and documentation, and are
            released publicly as the accompanying papers appear. Graduate students in the lab
            learn this workflow from their first semester, including AI-assisted development
            practices.
          </p>
          <p>
            <a class="btn btn--ghost" href="/research/software">Software &amp; facilities</a>
          </p>
        </div>
      </article>

      <div class="partners">
        <h2>Partnerships and roles</h2>
        <ul>
          <li>
            Professor Seo is a member of the ISSC Specialist Committee V.4 — Offshore
            Renewable Energy for 2025–2028, representing the Republic of Korea.
          </li>
          <li>
            The lab participates as co-investigator in the MOF-funded BEACON marine workforce
            project (2025–2029) and the MOTIE-funded Digital Shipyard professional training
            programme (2026–2031).
          </li>
          <li>
            We welcome collaboration with classification societies, shipyards, offshore energy
            and marine technology developers, and research groups working on structural
            fracture and fatigue assessment, computational mechanics, or condition monitoring.
            Contact:{' '}
            <a href="mailto:jaehoon.seo@inha.ac.kr">jaehoon.seo@inha.ac.kr</a>
          </li>
        </ul>
      </div>
    </div>
  </section>
</Base>

<style>
  .how {
    padding-bottom: 2.2rem;
  }

  .jump ol {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    gap: 0.3rem 1.4rem;
    margin: 1.6rem 0 0;
    padding: 0;
    list-style: none;
    counter-reset: jump;
  }

  .jump a {
    display: flex;
    gap: 0.6rem;
    padding: 0.35rem 0;
    font-size: 0.88rem;
    line-height: 1.4;
    text-decoration: none;
  }

  .jump a:hover {
    text-decoration: underline;
  }

  .jump-n {
    flex: none;
    font-family: var(--font-sans);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--c-accent);
    padding-top: 0.15em;
  }

  .how h2 {
    margin-top: 0;
  }

  .area {
    display: grid;
    grid-template-columns: 4rem 1fr;
    gap: 1.5rem;
    padding-block: 2.5rem;
    border-top: 1px solid var(--c-border);
    scroll-margin-top: 2rem;
  }

  .area h2 {
    margin-top: 0;
  }

  /* Figures are drawn for paper white, so they keep a light panel in dark mode
     rather than being inverted or left to float on a dark background. */
  .area-figure {
    margin: 1.6rem 0 0;
    padding: 0.9rem 0.9rem 0.6rem;
    background: #ffffff;
    border: 1px solid var(--c-border);
    border-radius: 3px;
  }

  .area-figure img {
    display: block;
    width: 100%;
    height: auto;
  }

  .area-figure figcaption {
    margin-top: 0.7rem;
    font-size: 0.82rem;
    line-height: 1.5;
    color: #46484d;
  }

  .area h3 {
    font-size: 0.82rem;
    font-family: var(--font-sans);
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--c-text-muted);
    margin-top: 1.6em;
  }

  .area-index {
    font-family: var(--font-body);
    font-size: 1.6rem;
    color: var(--c-accent);
    margin: 0;
    line-height: 1.4;
  }

  .topics {
    padding-left: 1.1rem;
  }

  .topics li {
    margin-bottom: 0.5rem;
  }

  .funding ul {
    padding-left: 1.1rem;
    margin-bottom: 0.5rem;
  }

  .funding li {
    font-size: 0.92rem;
    margin-bottom: 0.3rem;
  }

  .funding p,
  .selected p {
    font-size: 0.9rem;
    margin-bottom: 0;
  }

  .selected ol {
    counter-reset: cite;
    margin-bottom: 0.7rem;
  }

  .selected li {
    counter-increment: cite;
    position: relative;
    padding-left: 1.6rem;
    margin-bottom: 0.7rem;
    font-size: 0.93rem;
    line-height: 1.5;
    max-width: 76ch;
  }

  .selected li::before {
    content: counter(cite) '.';
    position: absolute;
    left: 0;
    color: var(--c-text-faint);
    font-variant-numeric: tabular-nums;
  }

  .cite-authors {
    color: var(--c-text-muted);
  }

  .selected a {
    text-decoration: none;
  }

  .selected a:hover {
    text-decoration: underline;
  }

  .lineage {
    font-size: 0.94rem;
    border-left: 3px solid var(--c-sky);
    padding: 0.8rem 1.1rem;
    background: var(--c-accent-soft);
    border-radius: 0 var(--radius) var(--radius) 0;
    max-width: 72ch;
  }

  .aside,
  .methods {
    font-size: 0.94rem;
    color: var(--c-text-muted);
    border-left: 3px solid var(--c-border-strong);
    padding: 0.7rem 1rem;
    background: var(--c-bg-subtle);
    border-radius: 0 var(--radius) var(--radius) 0;
    max-width: 72ch;
  }


  .cross .area-index {
    font-size: 2rem;
    line-height: 1.1;
  }

  .partners {
    border-top: 1px solid var(--c-border);
    padding-top: 2.5rem;
  }

  .partners h2 {
    margin-top: 0;
  }

  .partners li {
    margin-bottom: 0.6rem;
  }

  @media (max-width: 640px) {
    .area {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }
  }
</style>
