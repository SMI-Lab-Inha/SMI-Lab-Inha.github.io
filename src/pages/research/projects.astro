---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Pending from '../../components/Pending.astro';
import { projects } from '../../data/content';

const list = [...projects].sort((a, b) => {
  const order = { current: 0, planned: 1, completed: 2 };
  return order[a.status] - order[b.status];
});
const groups = [
  { label: 'Principal Investigator', labelKo: '연구책임자', role: 'Principal Investigator' },
  { label: 'Co-Investigator', labelKo: '참여연구자', role: 'Co-Investigator' },
]
  .map((g) => ({ ...g, items: list.filter((p) => p.role === g.role) }))
  .filter((g) => g.items.length > 0);
---

<Base title="Projects" description="Funded SMI Lab projects in structural integrity, offshore renewable energy, marine workforce development, and digital shipyard engineering.">
  <PageHeader
    eyebrow="Research"
    title="Projects"
    lead="Funded research with national agencies and the university."
  />

  <section class="section">
    <div class="wrap">
      {
        groups.length === 0 ? (
          <Pending
            what="No projects are listed yet."
          />
        ) : (
          groups.map((g) => (
            <div class="group">
              <h2>
                {g.label} <span class="ko">— {g.labelKo}</span>
              </h2>
              <div class="stack">
                {g.items.map((p) => (
                  <article class="card">
                    <p class={`status status--${p.status}`}>{p.status}</p>
                    <h3>{p.title}</h3>
                    {p.titleKo && <p class="ko-title" lang="ko">{p.titleKo}</p>}
                    <p class="meta">
                      {p.funder}
                      {p.period && <span> · {p.period}</span>}
                      {p.awardNumber && <span> · Award {p.awardNumber}</span>}
                    </p>
                    {p.summary && <p>{p.summary}</p>}
                    {(p.url || p.relatedDois.length > 0) && (
                      <p class="project-links">
                        {p.url && <a href={p.url}>Project source</a>}
                        {p.relatedDois.map((doi) => (
                          <a href={`https://doi.org/${doi}`}>Related publication</a>
                        ))}
                      </p>
                    )}
                  </article>
                ))}
              </div>
            </div>
          ))
        )
      }
    </div>
  </section>
</Base>

<style>
  .group + .group {
    margin-top: 3rem;
  }

  .group h2 {
    margin-top: 0;
    font-size: 1.25rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--c-border);
  }

  .ko {
    font-weight: 400;
    font-size: 0.95rem;
    color: var(--c-text-muted);
  }

  .stack {
    display: grid;
    gap: 1.2rem;
  }

  .card h3 {
    font-size: 1.08rem;
    margin-bottom: 0.2rem;
  }

  .status {
    display: inline-block;
    margin: 0 0 0.55rem;
    padding: 0.12em 0.6em;
    border: 1px solid var(--c-border-strong);
    border-radius: 999px;
    color: var(--c-text-muted);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .status--current {
    color: var(--c-accent-hover);
    background: var(--c-accent-soft);
    border-color: var(--c-accent);
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    font-size: 0.88rem;
  }

  .ko-title {
    color: var(--c-text-muted);
    font-size: 0.93rem;
    margin-bottom: 0.5rem;
  }

  .meta {
    font-size: 0.92rem;
    color: var(--c-text-muted);
    margin-bottom: 0.7rem;
  }

  .card p:last-child {
    margin-bottom: 0;
  }
</style>
