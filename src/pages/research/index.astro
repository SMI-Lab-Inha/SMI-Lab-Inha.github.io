---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';

const sections = [
  {
    href: '/research/research-areas',
    title: 'Research areas',
    text: 'Three thrusts — mooring and cable integrity, ultimate strength, fracture and impact — plus research software engineering.',
  },
  {
    href: '/research/software',
    title: 'Software & facilities',
    text: 'Our open-source packages, the commercial stack they sit alongside, and the lab computing setup.',
  },
  {
    href: '/research/projects',
    title: 'Projects',
    text: 'Funded research with national agencies, classification societies, and industry.',
  },
];
---

<Base title="Research" description="Research on floating offshore wind moorings and cables, ship ultimate strength, ductile fracture, structural digital twins, and open engineering software.">
  <PageHeader eyebrow="Research" title="Research" />

  <section class="section">
    <div class="wrap">
      <div class="grid">
        {
          sections.map((s) => (
            <a class="card link-card" href={s.href}>
              <h3>{s.title}</h3>
              <p class="muted">{s.text}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .link-card {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .link-card:hover {
    border-color: var(--c-accent);
    color: inherit;
  }

  .link-card h3 {
    color: var(--c-accent);
  }
</style>
