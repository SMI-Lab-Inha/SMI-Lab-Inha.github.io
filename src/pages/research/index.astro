---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';

const sections = [
  {
    href: '/research/research-areas',
    title: 'Research areas',
    text: 'Ultimate strength, fatigue and fracture, dynamic response, accidental and damage conditions, offshore renewable energy, and assessment during operations.',
  },
  {
    href: '/research/software',
    title: 'Software & facilities',
    text: 'Our own packages, the commercial software we use, and our computers.',
  },
  {
    href: '/research/projects',
    title: 'Projects',
    text: 'Projects funded by national agencies and the university.',
  },
];
---

<Base title="Research" description="Fracture and fatigue research for ships and offshore structures, supported by structural mechanics, virtual sensing, and open engineering software.">
  <PageHeader eyebrow="Research" title="Research" />

  <section class="section">
    <div class="wrap">
      <div class="grid">
        {
          sections.map((s) => (
            <a class="card link-card" href={s.href}>
              <h2>{s.title}</h2>
              <p class="muted">{s.text}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .link-card {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .link-card:hover {
    border-color: var(--c-accent);
    color: inherit;
  }

  .link-card h2 {
    color: var(--c-accent);
    font-size: 1.1rem;
    letter-spacing: -0.011em;
    margin-top: 0;
  }
</style>
