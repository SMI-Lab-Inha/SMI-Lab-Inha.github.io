---
import Base from '../layouts/Base.astro';
---

<Base
  title="Page not found"
  description="The requested SMI Lab page could not be found or may have moved during the site rebuild."
  noindex
>
  <section class="section">
    <div class="wrap wrap--narrow">
      <h1>Page not found</h1>
      <p class="lead">
        That page does not exist. It may have moved when the lab site was rebuilt.
      </p>
      <p>
        <a class="btn" href="/">Return home</a>
      </p>
    </div>
  </section>
</Base>
